{
  "command": [
    "/root/ecpa-h2-formal-profiler-kv-a-v1/bin/python",
    "-c",
    "pass"
  ],
  "environment": {
    "VLLM_ASCEND_KVCOMPRESS_ENABLED": "1",
    "VLLM_PLUGINS": "ascend,ascend_kvcompress,request_lifecycle_profiler",
    "VLLMHUST_EXT_ENABLED_BUNDLES": "org.vllm-hust.ascend-kvcompress,org.vllm-hust.request-lifecycle-profiler"
  },
  "native_extension_manifests": {
    "org.vllm-hust.ascend-kvcompress": {
      "schema_version": "1.0",
      "bundle_id": "org.vllm-hust.ascend-kvcompress",
      "bundle_version": "0.9.0",
      "host_api_range": ">=1,<2",
      "components": [
        {
          "component_id": "ascend-kvcompress",
          "contracts": [
            "vllm.general_plugins"
          ],
          "execution_planes": [
            "scheduler",
            "worker",
            "device"
          ],
          "isolation": "trusted_in_process",
          "implementation_ref": "vllm_ascend_kvcompress.plugin:register",
          "permissions": [
            "device_access",
            "filesystem_read",
            "filesystem_write",
            "network_egress"
          ]
        }
      ]
    },
    "org.vllm-hust.request-lifecycle-profiler": {
      "schema_version": "1.0",
      "bundle_id": "org.vllm-hust.request-lifecycle-profiler",
      "bundle_version": "0.1.2",
      "host_api_range": ">=1,<2",
      "components": [
        {
          "component_id": "request-lifecycle-profiler-native-sink",
          "contracts": [
            "vllm.request-lifecycle-events.v1"
          ],
          "execution_planes": [
            "api",
            "scheduler"
          ],
          "isolation": "trusted_in_process",
          "implementation_ref": "vllm_request_lifecycle_profiler.plugin:register_plugin",
          "permissions": []
        }
      ]
    }
  }
}
