"""Post-hoc CPU hypothesis check, not observation of device reduction algorithm."""
import hashlib,itertools,json
from pathlib import Path
import numpy as np
base=Path('/root/workspace/muxpd-gdn-decode-collective-20261029/probe-v1/runs-v1/dtp-v1-native-dtp-observed-01/results/dtp-observations')
out=Path(__file__).parent
sources={}
def read(rank,name):
 p=base/f'rank-{rank}'/f'{name}.npy'
 sources[str(p)]={'sha256':hashlib.sha256(p.read_bytes()).hexdigest()}
 x=np.load(p,allow_pickle=False).reshape(-1)
 assert x.dtype==np.float32 and len(x)==2048 and np.all(np.isfinite(x))
 assert np.all((x.view(np.uint32)&0xffff)==0)
 return x
xs=[read(i,'input') for i in range(4)]
a,b,c=[read(0,n) for n in ['actual','B0','C0']]
assert np.array_equal(a.view(np.uint32),c.view(np.uint32))
def bf16(x):
 u=np.asarray(x,dtype=np.float32).view(np.uint32)
 return ((u+np.uint32(0x7fff)+((u>>16)&1))&np.uint32(0xffff0000)).view(np.float32)
def trees(seq):
 if len(seq)==1: return [seq[0]]
 return [(l,r) for k in range(1,len(seq)) for l in trees(seq[:k]) for r in trees(seq[k:])]
def calc(t):
 if isinstance(t,int):return xs[t]
 return bf16(calc(t[0])+calc(t[1]))
records=[]
for perm in itertools.permutations(range(4)):
 for t in trees(perm):
  z=calc(t);records.append({'tree':str(t),'A_mismatch':int(np.count_nonzero(z!=a)),'B_mismatch':int(np.count_nonzero(z!=b)),'A_512_chunks':[int(np.count_nonzero(z[i:i+512]!=a[i:i+512])) for i in range(0,2048,512)],'B_512_chunks':[int(np.count_nonzero(z[i:i+512]!=b[i:i+512])) for i in range(0,2048,512)]})
wide=bf16(np.sum(np.stack(xs).astype(np.float64),axis=0).astype(np.float32))
r={'scope':'Post-hoc CPU RNE BF16 binary-tree simulations over actual per-rank inputs. Matches do not observe HCCL algorithm or prove a portable correction. No NPU use or qualification change.','sources':sources,'all_120_ordered_binary_trees':records,'A_full_matches':[x['tree'] for x in records if x['A_mismatch']==0],'B_full_matches':[x['tree'] for x in records if x['B_mismatch']==0],'wide_sum_final_bf16':{'A_mismatch':int(np.count_nonzero(wide!=a)),'B_mismatch':int(np.count_nonzero(wide!=b))},'A_best':sorted(records,key=lambda x:x['A_mismatch'])[:6],'B_best':sorted(records,key=lambda x:x['B_mismatch'])[:6]}
with (out/'result.json').open('x') as f:json.dump(r,f,indent=2);f.write('\n')
print(json.dumps({k:v for k,v in r.items() if k not in ['sources','all_120_ordered_binary_trees']},indent=2))
