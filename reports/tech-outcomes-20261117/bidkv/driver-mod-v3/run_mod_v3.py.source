"""Own and wait each new MOD experiment child; retain real return codes."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import time
import traceback

ROOT=Path('/workspace/bidkv-five-datasets-20261113-01')
PERSIST=ROOT/'durable'
DRIVER=Path(__file__).resolve().parent
RECEIPT=PERSIST/'metadata/mod-v3-lifecycle.json'
STATE={'phase':'starting','pid':os.getpid(),'started_unix':time.time(),'children':[],
       'native_preflight_supervisor_receipt':str(PERSIST/'metadata/native04-owned-supervisor.json')}

def save():
    temporary=RECEIPT.with_suffix('.tmp');temporary.write_text(json.dumps(STATE,indent=2)+'\n');temporary.replace(RECEIPT)

def cancel(signum,frame):
    raise KeyboardInterrupt('Owned MOD lifecycle cancelled by signal '+str(signum))

def run_child(name,command):
    record={'name':name,'command':command,'started_unix':time.time(),'status':'starting'}
    STATE['children'].append(record);STATE['phase']=name;save()
    log=(PERSIST/'logs'/('mod-v3-'+name+'.log')).open('ab',buffering=0)
    child=subprocess.Popen(command,cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,start_new_session=True,
                           env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1','PYTHONUNBUFFERED':'1'})
    record.update(pid=child.pid,status='running');save()
    try:
        code=child.wait()
    except BaseException:
        if child.poll()is None:
            os.killpg(child.pid,signal.SIGTERM)
            try:child.wait(timeout=600)
            except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL);child.wait(timeout=30)
        record.update(actual_returncode=child.returncode,status='cancelled',ended_unix=time.time());save()
        raise
    record.update(actual_returncode=code,status='completed'if code==0 else'failed',ended_unix=time.time());save()
    if code:raise RuntimeError('Owned child failed with actual returncode '+str(code)+': '+name)

def main(args):
    os.umask(0o077)
    assert not RECEIPT.exists(),'Use a new lifecycle identity; no automatic retry'
    for signum in[signal.SIGTERM,signal.SIGINT]:signal.signal(signum,cancel)
    save()
    try:
        manifest=json.loads((DRIVER/'source-manifest.json').read_bytes())
        for name,digest in manifest['files'].items():assert hashlib.sha256((DRIVER/name).read_bytes()).hexdigest()==digest,name
        STATE['source_manifest_sha256']=hashlib.sha256((DRIVER/'source-manifest.json').read_bytes()).hexdigest();save()
        python=str(ROOT/'.venv/bin/python')
        run_child('native-c8',[python,'-B',str(DRIVER/'c8-native-controller.py')])
        deadline=time.monotonic()+30
        while True:
            native_preflight=json.loads((PERSIST/'metadata/native04-owned-supervisor.json').read_bytes())
            if native_preflight['phase']in['completed','failed']:break
            assert time.monotonic()<deadline,'Native preflight supervisor did not seal actual exit'
            time.sleep(0.2)
        assert native_preflight['phase']=='completed'and native_preflight['actual_returncode']==0,native_preflight
        STATE['native_preflight_actual_returncode']=native_preflight['actual_returncode'];save()
        run_child('bidkv-c8',[python,'-B',str(DRIVER/'c8-bidkv-controller.py')])
        run_child('full-five',[python,'-B',str(DRIVER/'campaign81.py'),'--out',str(args.out)])
        STATE.update(phase='completed',completed_unix=time.time());save();return 0
    except BaseException as error:
        STATE.update(phase='failed',error=type(error).__name__+': '+str(error),failed_unix=time.time());save()
        # A controller owns its preflight's model; request its cleanup if the
        # lifecycle itself is cancelled before that controller could finish.
        for name in['native-04','bidkv-03']:
            folder=PERSIST/'preflight'/name
            if folder.exists()and not(folder/'stop.json').exists():(folder/'stop-requested').write_text('MOD lifecycle cancelled or failed; release only this owned service\n')
        traceback.print_exc();return 2

if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--out',type=Path,required=True)
    raise SystemExit(main(parser.parse_args()))
