"""Wait for exact admission, run the sealed C8 transport, then release our model."""
import hashlib
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import time
import traceback

ROOT=Path('/workspace/bidkv-five-datasets-20261113-01')
PERSIST=ROOT/'durable'
OUT=PERSIST/'qualification/bidkv-c8-03'
META=PERSIST/'metadata/c8-bidkv03-controller.json'
PREFLIGHT=PERSIST/'preflight/bidkv-03'
DRIVER=PERSIST/'sources/bidkv81-mod-v3'
CLIENT=None
STATE={'phase':'waiting-native-c8-qualification','pid':os.getpid(),'started_unix':time.time(),'c8_transport_commit':'b8a1c0c0062abce4b08e367ff003b1416df0afa2'}

def save():
    temp=META.with_suffix('.tmp');temp.write_text(json.dumps(STATE,indent=2)+'\n');temp.replace(META)

def cancel_controller(signum,frame):
    raise KeyboardInterrupt('Owned C8 controller cancelled by signal '+str(signum))
signal.signal(signal.SIGTERM,cancel_controller)

try:
    os.umask(0o077);save()
    assert shutil.disk_usage(PERSIST).free>=4*1024**3
    deadline=time.monotonic()+2400
    while True:
        path=PERSIST/'metadata/c8-native03-controller.json'
        if not path.exists():time.sleep(1);continue
        prior=json.loads(path.read_bytes())
        assert prior['phase']!='failed',prior
        if prior['phase']=='completed':break
        assert time.monotonic()<deadline,'Native C8 wait expired'
        time.sleep(5)
    assert json.loads((PERSIST/'qualification/native-c8-03/continuous.json').read_bytes())['status']=='completed'
    assert subprocess.check_output(['npu-smi','info'],text=True).count('No running processes found in NPU')==2
    log=(PERSIST/'logs/bidkv-fixed-preflight03.log').open('ab',buffering=0)
    preflight=subprocess.Popen([str(ROOT/'.venv/bin/python'),'-B',str(DRIVER/'bidkv-preflight.py')],cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
    STATE.update(phase='waiting-exact-token-admission',preflight_pid=preflight.pid);save()
    plan=json.loads((DRIVER/'admission-plan.json').read_bytes())
    for name,digest in plan['sources_sha256'].items():
        assert hashlib.sha256((DRIVER/name).read_bytes()).hexdigest()==digest
    deadline=time.monotonic()+1800
    while True:
        if not(PREFLIGHT/'status.json').exists():
            assert preflight.poll()is None,'Candidate preflight exited before status'
            time.sleep(1);continue
        value=json.loads((PREFLIGHT/'status.json').read_bytes())
        assert value['phase']!='failed',value
        if value['phase']=='tokens-admitted-awaiting-execution-sources':
            admission=json.loads((PREFLIGHT/'token-id-admission.json').read_bytes())
            assert admission['complete'] and len(admission['checked'])==128
            break
        assert time.monotonic()<deadline,'Preflight wait deadline exceeded'
        time.sleep(5)
    binding=json.loads((PREFLIGHT/'binding-evidence.json').read_bytes());assert binding['requested_default_enable_cpu_binding'] is True
    STATE.update(phase='running-bidkv-c8',binding_warning_or_skip_seen=binding['warning_or_skip_seen']);save()
    log=(PERSIST/'logs/c8-bidkv03-client.log').open('ab',buffering=0)
    result=subprocess.Popen([str(ROOT/'.venv/bin/python'),'-B',str(DRIVER/'continuous.py'),'--inputs',str(PERSIST/'controlled/initial-inputs-01/continuous-inputs-r1.json'),'--out',str(OUT)],cwd=ROOT,stdout=log,stderr=subprocess.STDOUT,start_new_session=True)
    CLIENT=result;result.wait()
    journals=list((PREFLIGHT/'policy').glob('*.jsonl'))
    assert journals,'No policy initialization journal'
    summaries=[]
    for journal in journals:
        events=[json.loads(line)for line in journal.read_text().splitlines()if line.strip()]
        assert events[0]['event']=='initialized'
        stats=events[-1]['stats'];assert stats['enabled'] and stats['policy']=='bidkv.adapters.vllm_hust.selector.BidkvPreemptionPolicy'
        assert stats['failures']==stats['invalid_selections']==0
        summaries.append(stats)
    (OUT/'policy-summary.json').write_text(json.dumps(summaries,indent=2)+'\n')
    STATE.update(client_exit_code=result.returncode,phase='releasing-owned-model');save()
    (PREFLIGHT/'stop-requested').write_text('C8 fully drained or failed; release this owned service\n')
    deadline=time.monotonic()+240
    while True:
        value=json.loads((PREFLIGHT/'status.json').read_bytes())
        if value['phase'] in ['preflight-complete','failed']:break
        assert time.monotonic()<deadline,'Owned model cleanup wait exceeded'
        time.sleep(2)
    STATE['preflight_actual_returncode']=preflight.wait(timeout=30)
    assert preflight.returncode==0,'Candidate preflight cleanup returned nonzero'
    STATE.update(model_final_phase=value['phase'],phase='completed' if result.returncode==0 else 'failed',completed_unix=time.time());save()
    assert result.returncode==0,'C8 client returned nonzero; retained failure'
except BaseException as error:
    if CLIENT is not None and CLIENT.poll()is None:
        os.killpg(CLIENT.pid,signal.SIGTERM)
        try:CLIENT.wait(timeout=30)
        except subprocess.TimeoutExpired:os.killpg(CLIENT.pid,signal.SIGKILL);CLIENT.wait(timeout=30)
    if CLIENT is not None:STATE['client_actual_returncode']=CLIENT.returncode
    STATE.update(phase='failed',error=type(error).__name__+': '+str(error),failed_unix=time.time());save();traceback.print_exc()
    if PREFLIGHT.exists():(PREFLIGHT/'stop-requested').write_text('Controller failed; release only this owned model\n')
    raise
