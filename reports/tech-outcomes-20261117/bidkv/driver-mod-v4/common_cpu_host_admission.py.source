"""Read-only fresh import, copied-byte and real topology admission; no binding."""
import argparse
from collections import defaultdict
import hashlib
import importlib.metadata
import json
from pathlib import Path
import sys


def main(args):
    sys.path[:0] = [str(args.vllm_root), str(args.ascend_root), *args.extra_python_path]
    import vllm_ascend.cpu_binding as binding
    expected = args.ascend_root/'vllm_ascend/cpu_binding.py'
    assert Path(binding.__file__).resolve() == expected.resolve()
    admission = json.loads((args.ascend_root/'source-admission.json').read_bytes())
    libraries = 0
    for item in admission['source_files']:
        digest = admission['cpu_binding_prepared_sha256'] if item['path'] == 'vllm_ascend/cpu_binding.py' else item['source_sha256']
        assert hashlib.sha256((args.ascend_root/item['path']).read_bytes()).hexdigest() == digest, item['path']
        libraries += item['path'].endswith('.so')
    original = args.upstream_ascend_root/'vllm_ascend/cpu_binding.py'
    assert hashlib.sha256(original.read_bytes()).hexdigest() == admission['cpu_binding_original_sha256']
    versions = {name: importlib.metadata.version(name) for name in ['torch', 'torch-npu', 'vllm', 'vllm-ascend', 'transformers', 'tokenizers']}
    assert versions == {'torch': '2.10.0+cpu', 'torch-npu': '2.10.0.post4', 'vllm': '0.23.0+empty', 'vllm-ascend': '0.23.0', 'transformers': '5.5.4', 'tokenizers': '0.22.2'}
    info = object.__new__(binding.DeviceInfo)
    info.npu_map_info = info.get_npu_map_info()
    info.allowed_cpus = info.parse_allowed_cpus()
    info.npu_affinity = info.parse_topo_affinity()
    info.all_logic_npus = info.get_all_logic_npus()
    info.total_logic_npus = len(info.all_logic_npus)
    physical = [int(value) for value in args.physical.split(',')]
    logical = [int(value) for value in args.logical.split(',')]
    assert [info.resolve_logic_id(str(device), '0') for device in physical] == logical
    assert all(set(info.npu_affinity[device]) & set(info.allowed_cpus) for device in logical)
    info.running_npu_list = logical  # Preview only; no NPU process or binding is created.
    allocator = object.__new__(binding.CpuAlloc)
    allocator.device_info, allocator.cpu_node = info, {}
    allocator.numa_to_cpu_map, allocator.npu_cpu_pool = defaultdict(list), {}
    allocator.build_cpu_node_map()
    allocator._build_topo_affinity_cpu_pool()
    report = {'cpu_binding_import_file': binding.__file__, 'prepared_cpu_binding_sha256': admission['cpu_binding_prepared_sha256'],
              'source_and_library_files_verified': len(admission['source_files']), 'matching_prebuilt_so_count': libraries,
              'upstream_original_unchanged': True, 'physical_to_logical_map': info.npu_map_info,
              'actual_topology_logical_cpu_affinity': info.npu_affinity, 'planned_cpu_pools_only': allocator.npu_cpu_pool,
              'no_binding_irq_or_migration_called': True, 'versions': versions, 'model_generation_requests': 0}
    args.out.write_text(json.dumps(report, indent=2)+'\n', encoding='utf-8')
    print(json.dumps(report))


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    for name in ['vllm-root', 'ascend-root', 'upstream-ascend-root', 'out']:
        parser.add_argument('--'+name, type=Path, required=True)
    parser.add_argument('--physical', required=True)
    parser.add_argument('--logical', default='0,1')
    parser.add_argument('--extra-python-path', action='append', default=[])
    main(parser.parse_args())
