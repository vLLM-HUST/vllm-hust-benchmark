"""Own a zero-generation preflight and record its actual OS return code."""
import argparse
import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import time
import traceback


def main(args):
    os.umask(0o077)
    receipt=args.receipt
    assert not receipt.exists(),'Use a new supervisor receipt; do not overwrite an attempt'
    state={'phase':'starting','pid':os.getpid(),'started_unix':time.time(),'script':str(args.script),
           'script_sha256':hashlib.sha256(args.script.read_bytes()).hexdigest(),'model_generation_requests':0}
    child=None
    def save():
        temp=receipt.with_suffix('.tmp');temp.write_text(json.dumps(state,indent=2)+'\n');temp.replace(receipt)
    def cancel(signum,frame):
        raise KeyboardInterrupt('Owned preflight supervisor cancelled by signal '+str(signum))
    for signum in[signal.SIGINT,signal.SIGTERM]:signal.signal(signum,cancel)
    save()
    try:
        stream=args.log.open('ab',buffering=0)
        child=subprocess.Popen([args.python,'-B',str(args.script)],stdout=stream,stderr=subprocess.STDOUT,
                               env={**os.environ,'PYTHONDONTWRITEBYTECODE':'1','PYTHONUNBUFFERED':'1'},start_new_session=True)
        state.update(phase='running',preflight_pid=child.pid);save()
        code=child.wait()
        state.update(phase='completed'if code==0 else'failed',actual_returncode=code,ended_unix=time.time());save()
        return code
    except BaseException as error:
        if child is not None and child.poll()is None:
            os.kill(child.pid,signal.SIGTERM)
            try:child.wait(timeout=240)
            except subprocess.TimeoutExpired:os.killpg(child.pid,signal.SIGKILL);child.wait(timeout=30)
        state.update(phase='failed',error=type(error).__name__+': '+str(error),actual_returncode=child.returncode if child is not None else None,ended_unix=time.time());save()
        traceback.print_exc();return 2


if __name__=='__main__':
    parser=argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--script',type=Path,required=True)
    parser.add_argument('--python',required=True)
    parser.add_argument('--receipt',type=Path,required=True)
    parser.add_argument('--log',type=Path,required=True)
    raise SystemExit(main(parser.parse_args()))
