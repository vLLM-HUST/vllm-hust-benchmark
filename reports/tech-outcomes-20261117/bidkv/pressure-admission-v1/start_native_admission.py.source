"""Start only the fixed Native zero-generation admission after primary release."""

import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import time

ROOT = Path("/workspace/bidkv-five-datasets-20261113-01")
PERSIST = ROOT / "durable"
PROBE = PERSIST / "probes/bidkv-pressure-01"
DRIVER = Path(__file__).resolve().parent


def main():
    os.umask(0o077)

    def cancel(signum, _frame):
        raise KeyboardInterrupt(
            "Owned zero-generation supervisor cancelled by signal " + str(signum)
        )

    for signum in [signal.SIGTERM, signal.SIGINT]:
        signal.signal(signum, cancel)
    manifest = json.loads((DRIVER / "source-manifest.json").read_bytes())
    source_hash = hashlib.sha256(
        (DRIVER / "source-manifest.json").read_bytes()
    ).hexdigest()
    for name, expected in manifest["files"].items():
        assert hashlib.sha256((DRIVER / name).read_bytes()).hexdigest() == expected, (
            name
        )
    release = json.loads(
        (
            PERSIST / "metadata/pressure01-zero-generation-public-release.json"
        ).read_bytes()
    )
    assert (
        release["source_manifest_sha256"] == source_hash
        and release["zero_generation_only"] is True
    )
    assert len(release["public_commit"]) == 40
    primary = json.loads((PERSIST / "metadata/mod-v4-lifecycle.json").read_bytes())
    completed = json.loads(
        (PERSIST / "results/five-datasets-mod-04/execution-checklist.json").read_bytes()
    )
    assert primary["phase"] == "completed" and completed["formal_complete"] is True
    assert all(child["actual_returncode"] == 0 for child in primary["children"])
    npu = subprocess.check_output(["npu-smi", "info"], text=True, timeout=20)
    assert npu.count("No running processes found in NPU") == 2, (
        "Do not occupy primary or another service"
    )
    PROBE.mkdir(parents=True, exist_ok=False, mode=0o700)
    (PROBE / "metadata").mkdir()
    clock = {
        "started_unix": time.time(),
        "started_monotonic": time.monotonic(),
        "host_boot_id_sha256": hashlib.sha256(
            Path("/proc/sys/kernel/random/boot_id").read_bytes()
        ).hexdigest(),
        "operation_limit_seconds": 3600,
        "scope": "Includes both cold initializations and publication parks; cleanup grace is reported separately",
        "zero_generation_source_manifest_sha256": source_hash,
        "initial_source_release": release,
    }
    clock["deadline_monotonic"] = clock["started_monotonic"] + 3600
    (PROBE / "metadata/clock.json").write_text(json.dumps(clock, indent=2) + "\n")
    # This process actually owns and waits for the model owner. The caller may
    # detach this supervisor; it never submits /v1/chat/completions traffic.
    state = {
        "phase": "starting-native-zero-generation",
        "pid": os.getpid(),
        "started_unix": time.time(),
        "source_manifest_sha256": source_hash,
        "submitted_generation_requests": 0,
    }

    def save():
        temp = PROBE / "metadata/native-owned-supervisor.tmp"
        temp.write_text(json.dumps(state, indent=2) + "\n")
        temp.replace(PROBE / "metadata/native-owned-supervisor.json")

    save()
    log = (PROBE / "metadata/native-admission.log").open("ab", buffering=0)
    child = subprocess.Popen(
        [
            str(ROOT / ".venv/bin/python"),
            "-B",
            str(DRIVER / "admission_owner.py"),
            "--arm",
            "native",
        ],
        cwd=ROOT,
        stdout=log,
        stderr=subprocess.STDOUT,
        env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
        start_new_session=True,
    )
    state.update(phase="running-native-zero-generation", child_pid=child.pid)
    save()
    try:
        code = child.wait()
    except BaseException:
        if child.poll() is None:
            os.kill(child.pid, signal.SIGTERM)
            try:
                child.wait(timeout=180)
            except subprocess.TimeoutExpired:
                os.killpg(child.pid, signal.SIGKILL)
                child.wait(timeout=30)
        state.update(
            phase="failed",
            actual_child_returncode=child.returncode,
            ended_unix=time.time(),
            error="Supervisor cancelled; owned preflight/model cleanup requested",
        )
        save()
        raise
    state.update(
        phase="completed" if code == 0 else "failed",
        actual_child_returncode=code,
        ended_unix=time.time(),
    )
    save()
    return code


if __name__ == "__main__":
    raise SystemExit(main())
