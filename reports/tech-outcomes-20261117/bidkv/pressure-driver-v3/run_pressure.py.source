"""One new Candidate diagnostic; preserve failed v2 and carry all Native8."""

import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import time
import traceback
from capacity_rules import evaluate

ROOT = Path("/workspace/bidkv-five-datasets-20261113-01")
PROBE = ROOT / "durable/probes/bidkv-pressure-01"
DRIVER = Path(__file__).resolve().parent


def save(path, value):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(json.dumps(value, indent=2) + "\n")
    temporary.replace(path)


def remaining():
    clock = json.loads((PROBE / "metadata/clock.json").read_bytes())
    assert (
        clock["host_boot_id_sha256"]
        == hashlib.sha256(
            Path("/proc/sys/kernel/random/boot_id").read_bytes()
        ).hexdigest()
    )
    return clock["deadline_monotonic"] - time.monotonic()


def main():
    path = PROBE / "metadata/pressure-corrective-v3-lifecycle.json"
    assert not path.exists()
    state = {
        "phase": "checking-corrective-release",
        "pid": os.getpid(),
        "started_unix": time.time(),
        "planned_new_candidate_requests": 8,
        "planned_new_native_requests": 0,
        "carried_native_requests": 8,
        "old_v2_status": "failed, unchanged",
        "owned_waits": [],
    }

    def checkpoint():
        save(path, state)

    def cancel(number, _frame):
        raise KeyboardInterrupt("Owned corrective controller signal" + str(number))

    for number in [signal.SIGTERM, signal.SIGINT]:
        signal.signal(number, cancel)

    def cleanup():
        folder = PROBE / "bidkv"
        (folder / "stop-requested").write_text(
            "Corrective diagnostic drained/failed; originalclock unchanged\n"
        )
        deadline = time.monotonic() + 180
        for name in [
            "bidkv/api-owned-wait.json",
            "metadata/bidkv-owned-supervisor.json",
        ]:
            while True:
                f = PROBE / name
                value = json.loads(f.read_bytes()) if f.exists() else {}
                if "actual_returncode" in value or "actual_child_returncode" in value:
                    break
                assert time.monotonic() < deadline, "Owned cleanup wait not sealed"
                time.sleep(0.5)
            state["owned_waits"].append({"receipt": str(f), "value": value})
            checkpoint()
        npu = subprocess.check_output(["npu-smi", "info"], text=True, timeout=20)
        (PROBE / "metadata/corrective-v3-npu-release.txt").write_text(npu)
        assert npu.count("No running processes found in NPU") == 2
        assert all(
            item["value"].get(
                "actual_returncode", item["value"].get("actual_child_returncode")
            )
            == 0
            for item in state["owned_waits"]
        )

    checkpoint()
    try:
        raw = (DRIVER / "source-manifest.json").read_bytes()
        digest = hashlib.sha256(raw).hexdigest()
        for name, expected in json.loads(raw)["files"].items():
            assert hashlib.sha256((DRIVER / name).read_bytes()).hexdigest() == expected
        release = json.loads(
            (
                PROBE / "metadata/generation-corrective-v3-public-release.json"
            ).read_bytes()
        )
        assert (
            release["source_manifest_sha256"] == digest
            and release["fixed_workload_go"] is True
            and release["candidate_identical_capacity_pre_authorized"] is True
        )
        assert (
            release["admission_source_manifest_sha256"]
            == "13dc6b582f81008e081c31ce1cd75096ea706989db185bc9bbea96fbe23d44f9"
        )
        carry_path = PROBE / "metadata/native-carry-baseline-audit-v3.json"
        assert (
            release["native_carry_audit_sha256"]
            == hashlib.sha256(carry_path.read_bytes()).hexdigest()
        )
        carry = json.loads(carry_path.read_bytes())
        assert (
            carry["passed"] is True
            and carry["verified_native_requests"] == 8
            and carry["original_controller_returncode"] == 2
        )
        assert (
            json.loads((PROBE / "metadata/pressure-lifecycle.json").read_bytes())[
                "phase"
            ]
            == "failed"
        )
        native_rpc = PROBE / "native/cache-groups-rpc.json"
        capacity_path = PROBE / "metadata/native-capacity-go-no-go-v2.json"
        assert (
            release["native_cache_rpc_sha256"]
            == hashlib.sha256(native_rpc.read_bytes()).hexdigest()
        )
        assert (
            release["capacity_report_sha256"]
            == hashlib.sha256(capacity_path.read_bytes()).hexdigest()
        )
        capacity = evaluate(json.loads(native_rpc.read_bytes()))
        assert (
            capacity == json.loads(capacity_path.read_bytes())
            and capacity["go_for_fixed_workload"] is True
        )
        while True:
            owner = json.loads((PROBE / "bidkv/status.json").read_bytes())
            assert owner["phase"] != "failed"
            if owner["phase"] == "admitted-awaiting-public-capacity-binding":
                break
            assert remaining() > 15
            time.sleep(1)
        candidate = evaluate(
            json.loads((PROBE / "bidkv/cache-groups-rpc.json").read_bytes())
        )
        assert (
            candidate["metadata_fingerprint_sha256"]
            == capacity["metadata_fingerprint_sha256"]
        )
        save(
            PROBE / "metadata/corrective-v3-bidkv-capacity-confirmation.json", candidate
        )
        assert remaining() > 15
        state.update(
            phase="bidkv-r01", public_release=release, source_manifest_sha256=digest
        )
        checkpoint()
        command = [
            str(ROOT / ".venv/bin/python"),
            "-B",
            str(DRIVER / "pressure_client.py"),
            "--arm",
            "bidkv",
            "--repeat",
            "1",
        ]
        with (PROBE / "metadata/corrective-v3-client.log").open(
            "ab", buffering=0
        ) as log:
            child = subprocess.Popen(
                command,
                cwd=ROOT,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
                env={**os.environ, "PYTHONDONTWRITEBYTECODE": "1"},
            )
            state.update(
                client_pid=child.pid, client_started_unix=time.time(), command=command
            )
            checkpoint()
            try:
                code = child.wait(timeout=max(1, remaining() + 20))
            except BaseException:
                if child.poll() is None:
                    os.killpg(child.pid, signal.SIGTERM)
                    try:
                        child.wait(timeout=20)
                    except subprocess.TimeoutExpired:
                        os.killpg(child.pid, signal.SIGKILL)
                        child.wait(timeout=20)
                state.update(
                    actual_client_returncode=child.returncode,
                    client_ended_unix=time.time(),
                )
                checkpoint()
                raise
        state.update(actual_client_returncode=code, client_ended_unix=time.time())
        checkpoint()
        assert code == 0, "Corrective fixedbatch failed, no retry"
        cleanup()
        state.update(phase="completed", completed_unix=time.time())
        checkpoint()
        return 0
    except BaseException as error:
        state.update(
            phase="failed",
            error=type(error).__name__ + ": " + str(error),
            failed_unix=time.time(),
        )
        checkpoint()
        traceback.print_exc()
        try:
            cleanup()
        except BaseException as cleanup_error:
            state["cleanup_error"] = (
                type(cleanup_error).__name__ + ": " + str(cleanup_error)
            )
            checkpoint()
        return 2


if __name__ == "__main__":
    os.umask(0o077)
    raise SystemExit(main())
