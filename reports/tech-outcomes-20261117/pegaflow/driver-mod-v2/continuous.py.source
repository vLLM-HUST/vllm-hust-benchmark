"""Independent transport for the unchanged frozen 4K/16K C8 recipe."""

import argparse
from concurrent.futures import ThreadPoolExecutor
import hashlib
import json
from pathlib import Path
import threading
import time
import traceback
import urllib.request
import uuid

from measurement import distribution
from observation import Sampler, snapshot, zero_reuse
from transport import call, clock

INPUT_SHA = 'a73c9e1b2afa476dea80f91832e963867f6f4130e4988d97210dddfea5aeb392'


def save(path, value):
    path = Path(path)
    temporary = path.with_suffix(path.suffix+'.tmp')
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2)+'\n')
    temporary.replace(path)


def run_phase(config, out, cases, name, seconds):
    failed = threading.Event()
    rows, lock = [], threading.Lock()
    before = snapshot(config['base_url'], out, name+'-before')
    external_before = snapshot(config['external_metrics_url'], out, name+'-external-before') if config.get('external_metrics_url') else None
    start = clock()
    deadline = start['monotonic']+seconds

    def lane(index):
        sequence = 0
        while time.monotonic() < deadline and not failed.is_set():
            identity = f'{name}-lane{index}-{sequence:05d}'
            body = dict(cases[index]['request'], cache_salt=uuid.uuid4().hex)
            row = call(config, body, out/'transport', fixed_length=True)
            if row['status'] == 'ok' and row['usage']['prompt_tokens'] != cases[index]['input_tokens']:
                row.update(status='input_tokenization_error', error='Actual input token count changed')
            row.update(case_id=identity, phase=name, lane=index, input_tokens=cases[index]['input_tokens'])
            save(out/(identity+'.json'), row)
            with lock:
                rows.append(row)
            sequence += 1
            if row['status'] != 'ok':
                failed.set()
                break

    with ThreadPoolExecutor(max_workers=8) as pool:
        list(pool.map(lane, range(8)))
    end = clock()
    after = snapshot(config['base_url'], out, name+'-after')
    external_after = snapshot(config['external_metrics_url'], out, name+'-external-after') if config.get('external_metrics_url') else None
    good = [row for row in rows if row['status'] == 'ok']
    result = {'name': name, 'start': start, 'submission_deadline_monotonic': deadline,
              'end': end, 'seconds': seconds, 'requests': len(rows),
              'failed': len(rows)-len(good), 'drain_seconds': max(0, end['monotonic']-deadline),
              'output_tokens_accepted_including_drain': sum(row['usage']['completion_tokens'] for row in good),
              'ttft_generated_seconds': distribution([row['first_generated_event']['monotonic']-row['start']['monotonic'] for row in good]),
              'tpot_completion_seconds': distribution([(row['end']['monotonic']-row['first_generated_event']['monotonic'])/255 for row in good]),
              'throughput_scope': 'Original duration bounds request submissions; all in-flight requests drained. Finite-batch standard uses separate first-submit/last-response metric.'}
    save(out/(name+'-phase.json'), result)
    # Preserve a phase result even when counter admission itself fails.
    proof = zero_reuse(before, after, rows, external_metrics=(external_before, external_after) if external_before is not None else None)
    save(out/(name+'-zero-reuse.json'), proof)
    if failed.is_set():
        raise RuntimeError('Retained request failure; this prospective arm stopped')
    print(json.dumps(result), flush=True)
    return result


def main(args):
    out = args.out
    out.mkdir(parents=True, exist_ok=False, mode=0o700)
    raw = args.inputs.read_bytes()
    assert hashlib.sha256(raw).hexdigest() == INPUT_SHA
    inputs = json.loads(raw)
    assert list(inputs) == ['4096', '16384'] and all(len(cases) == 8 for cases in inputs.values())
    config = {'base_url': args.base_url, 'timeout': 180, 'external_metrics_url': args.external_metrics_url}
    save(out/'plan.json', {'input_sha256': INPUT_SHA, 'concurrency': 8, 'warmup_seconds': 60,
                          'formal_seconds': 300, 'timeout_seconds': 180,
                          'ignore_eos': True, 'max_tokens': 256,
                          'scope': 'Separate original fixed-length synthetic qualification. All five actual datasets preserve EOS.',
                          'source_files': {path.name: hashlib.sha256(path.read_bytes()).hexdigest() for path in Path(__file__).parent.glob('*.py')}})
    state = {'phase': 'actual-input-tokenization', 'generation_requests': 0}
    save(out/'status.json', state)
    try:
        checked = []
        for length, cases in inputs.items():
            for index, case in enumerate(cases):
                body = {'model': 'qwen3.5-35b', 'messages': case['request']['messages'], 'add_generation_prompt': True}
                request = urllib.request.Request(args.base_url+'/tokenize', json.dumps(body).encode(), {'Content-Type': 'application/json'})
                with urllib.request.urlopen(request, timeout=60) as response:
                    value = json.load(response)
                save(out/f'tokenize-{length}-{index}.json', {'request': body, 'response': value})
                digest = hashlib.sha256(json.dumps(value['tokens']).encode()).hexdigest()
                assert (value['count'], digest) == (case['input_tokens'], case['token_ids_sha256'])
                checked.append({'length': length, 'lane': index, 'count': value['count'], 'token_ids_sha256': digest})
        save(out/'tokenize-admission.json', {'passed': True, 'checked': checked})
        phases = []
        with Sampler(out):
            for length, cases in inputs.items():
                for label, seconds in [('warmup', 60), ('formal', 300)]:
                    state.pop('generation_requests', None)
                    state.update(phase=length+'-'+label, started_unix=time.time())
                    save(out/'status.json', state)
                    phases.append(run_phase(config, out, cases, length+'-'+label, seconds))
        save(out/'continuous.json', {'status': 'completed', 'phases': phases,
                                     'scope': 'C8 synthetic continuous submission with full drain; separate from task quality and acceptance targets'})
        state.update(phase='completed', completed_unix=time.time())
        save(out/'status.json', state)
        return 0
    except BaseException as error:
        state.update(phase='failed', error=type(error).__name__+': '+str(error), failed_unix=time.time())
        save(out/'status.json', state)
        traceback.print_exc()
        return 2


if __name__ == '__main__':
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--inputs', type=Path, required=True)
    parser.add_argument('--out', type=Path, required=True)
    parser.add_argument('--base-url', default='http://127.0.0.1:18390')
    parser.add_argument('--external-metrics-url')
    raise SystemExit(main(parser.parse_args()))
