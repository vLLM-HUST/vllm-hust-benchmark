"""Validate the actual qualified 91 receipt schema without re-reading70GiB weights."""


def admit(receipt, expected, revision, model):
    if (
        receipt.get("phase") != "complete"
        or receipt.get("all_weights_match_expected") is not True
    ):
        raise ValueError(
            "91 weight receipt requires complete/all_weights_match_expected=true"
        )
    if receipt.get("expected_revision") != revision or receipt.get("model") != model:
        raise ValueError("Weight receipt model/revision differs")
    weights = [
        item
        for item in receipt.get("files", [])
        if item.get("path", "").startswith("model.safetensors-")
        and item["path"].endswith(".safetensors")
    ]
    actual = {item["path"]: item for item in weights}
    wanted = {item["path"]: item for item in expected}
    if (
        len(weights) != 14
        or len(actual) != 14
        or len(wanted) != 14
        or set(actual) != set(wanted)
    ):
        raise ValueError("Weight receipt omitted/duplicated/replaced a shard")
    for name, item in actual.items():
        if (
            item.get("matches_expected") is not True
            or item.get("bytes") != wanted[name]["bytes"]
            or item.get("sha256") != wanted[name]["sha256"]
        ):
            raise ValueError("Original actual size/hash/verification differs: " + name)
    return {
        "admitted": True,
        "shards": 14,
        "revision": revision,
        "model": model,
        "receipt_schema": "91 phase=complete/all_weights_match_expected=true with14 individually matching bytes/hash",
        "source": "Reuse recorded full-byte verification; no model rehash or inference in this admission",
    }
