"""Run both fresh PegaFlow81 C8 arms, then hand off to the frozen five cohort."""

import hashlib
import json
import os
from pathlib import Path
import signal
import subprocess
import time
import traceback
import urllib.request

from service81 import ROOT, PERSIST, Service, save, stop_owned, ticks, release_admission
from verify_c8 import inspect
from observation import zero_reuse, totals

INPUT = Path(
    "/data/shared_upload/cybber695/bidkv-five-datasets-20261113-01/controlled/initial-inputs-01"
)
DRIVER = Path(__file__).resolve().parent
OUT = PERSIST / "qualification"
STATE = {
    "phase": "checking-parent-resource-handoff-and-publication",
    "pid": os.getpid(),
    "started_unix": time.time(),
    "current_arm_generation_requests": 0,
    "completed_c8_generation_requests": 0,
    "scope": "New official0.23 Native/PegaFlow profile; C8 separate from all-five EOS datasets",
    "arms": {},
}
CHILD = None
CHILD_TICKS = None


def checkpoint():
    save(PERSIST / "metadata/c8-campaign-status.json", STATE)


def admitted(service, folder):
    rows = []
    folder.mkdir(parents=True, exist_ok=False)
    for item in json.loads((INPUT / "manifest.json").read_bytes()):
        raw = (INPUT / item["path"]).read_bytes()
        assert (
            len(raw) == item["bytes"]
            and hashlib.sha256(raw).hexdigest() == item["sha256"]
        )

    def admit(identity, body, count, expected, compact):
        request = urllib.request.Request(
            "http://127.0.0.1:18390/tokenize",
            json.dumps(body).encode(),
            {"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(request, timeout=60) as response:
            value = json.load(response)
        save(
            folder / "tokenize" / (identity + ".json"),
            {"request": body, "response": value},
        )
        ids = value["tokens"]
        assert len(ids) == value["count"] == count, identity
        encoded = json.dumps(ids, separators=(",", ":")) if compact else json.dumps(ids)
        digest = hashlib.sha256(encoded.encode()).hexdigest()
        assert digest == expected, (identity, digest, expected)
        rows.append({"case_id": identity, "tokens": count, "sha256": digest})
        save(
            folder / "token-id-admission.json",
            {"complete": False, "checked": rows, "generation_requests": 0},
        )

    for length, cases in json.loads(
        (INPUT / "continuous-inputs-r1.json").read_bytes()
    ).items():
        for index, case in enumerate(cases):
            admit(
                "c8-" + length + "-" + str(index),
                {
                    "model": "qwen3.5-35b",
                    "messages": case["request"]["messages"],
                    "add_generation_prompt": True,
                },
                case["input_tokens"],
                case["token_ids_sha256"],
                False,
            )
    for name in ["swe", "terminal"]:
        tasks = [
            json.loads(line)
            for line in (INPUT / name / "tasks.jsonl").read_text().splitlines()
            if line.strip()
        ]
        expected = {
            item["case_id"]: item
            for item in json.loads(
                (INPUT / name / "offline-token-id-freeze.json").read_bytes()
            )
        }
        for task in tasks:
            body = {
                "model": "qwen3.5-35b",
                "messages": task["source_body"]["messages"],
                "tools": task["source_body"].get("tools"),
                "add_generation_prompt": True,
                "continue_final_message": False,
                "add_special_tokens": False,
                "chat_template_kwargs": {"enable_thinking": False},
            }
            admit(
                task["case_id"],
                body,
                task["prompt_tokens"],
                expected[task["case_id"]]["token_ids_sha256"],
                True,
            )
    assert len(rows) == 128
    save(
        folder / "token-id-admission.json",
        {"complete": True, "checked": rows, "generation_requests": 0},
    )


def verify_external(folder):
    report = []
    for length in ["4096", "16384"]:
        for stage in ["warmup", "formal"]:
            name = length + "-" + stage
            rows = [
                json.loads(path.read_bytes())
                for path in folder.glob(name + "-lane*.json")
            ]
            proof = zero_reuse(
                (folder / (name + "-before-metrics.txt")).read_text(),
                (folder / (name + "-after-metrics.txt")).read_text(),
                rows,
                external_metrics=(
                    (folder / (name + "-external-before-metrics.txt")).read_text(),
                    (folder / (name + "-external-after-metrics.txt")).read_text(),
                ),
            )
            report.append({"phase": name, "proof": proof})
    return report


def mechanism(folder, service_folder):
    deltas = {}
    for length in ["4096", "16384"]:
        for label in ["warmup", "formal"]:
            phase = length + "-" + label
            before = totals((folder / (phase + "-before-metrics.txt")).read_text())
            after = totals((folder / (phase + "-after-metrics.txt")).read_text())
            for key, value in after.items():
                if key.endswith(
                    (
                        "pega_save_success_total",
                        "pega_load_success_total",
                        "pega_save_failure_total",
                        "pega_load_failure_total",
                    )
                ):
                    assert key in before
                    deltas[key] = deltas.get(key, 0) + value - before[key]
    before = totals((service_folder / "before-c8-sidecar-metrics.txt").read_text())
    after = totals((service_folder / "after-c8-sidecar-metrics.txt").read_text())
    save_keys = [key for key in after if key.endswith("save_bytes_total")]
    # The sidecar is fresh and has received no pre-C8 generation; lazy OTel
    # counters may be absent before the first save. This is positive-activation
    # evidence, not the independent strict zero-restore proof from vLLM.
    bytes_saved = sum(after[key] - before.get(key, 0) for key in save_keys)
    saves = sum(
        value
        for key, value in deltas.items()
        if key.endswith("pega_save_success_total")
    )
    loads = sum(
        value
        for key, value in deltas.items()
        if key.endswith("pega_load_success_total")
    )
    failures = sum(
        value
        for key, value in deltas.items()
        if key.endswith(("pega_save_failure_total", "pega_load_failure_total"))
    )
    result = {
        "engine_counter_deltas": deltas,
        "sidecar_save_bytes": bytes_saved,
        "sidecar_lazy_save_counters_absent_before": [
            key for key in save_keys if key not in before
        ],
        "actual_storage_save_activated": saves > 0 and bytes_saved > 0,
        "restore_successes": loads,
        "failures": failures,
        "scope": "Actual cold storage-save path activation only. Fresh salts require zero restores; no cache-restore performance benefit established.",
    }
    save(folder / "mechanism-activation.json", result)
    assert result["actual_storage_save_activated"] and loads == failures == 0, (
        "Pega C8 activation missing or failures/reuse observed"
    )
    return result


def cancelled(signum, frame):
    raise KeyboardInterrupt(
        "Owned PegaFlow81 qualification interrupted by signal " + str(signum)
    )


try:
    os.umask(0o077)
    for signum in [signal.SIGINT, signal.SIGTERM]:
        signal.signal(signum, cancelled)
    checkpoint()
    release_admission()
    source_release = PERSIST / "publication.json"
    manifest = json.loads((DRIVER / "source-manifest.json").read_bytes())
    manifest_sha256 = hashlib.sha256(
        (DRIVER / "source-manifest.json").read_bytes()
    ).hexdigest()
    for name, digest in manifest["files"].items():
        assert hashlib.sha256((DRIVER / name).read_bytes()).hexdigest() == digest, name
    OUT.mkdir(parents=True, exist_ok=False, mode=0o700)
    for arm, label in [("native", "pf81cn04"), ("pegaflow", "pf81cp04")]:
        STATE.update(phase=arm + "-model-and-token-admission", current_arm=arm)
        checkpoint()
        with Service(arm, OUT / ("service-" + arm), label) as service:
            admitted(service, OUT / (arm + "-actual-token-admission"))
            STATE.update(
                phase=arm + "-tokens-qualified-awaiting-public-release",
                current_arm_generation_requests=0,
                actual_tokenizations_passed=128,
            )
            checkpoint()
            release_deadline = time.monotonic() + 1800
            while not source_release.exists():
                assert service.process.poll() is None, "Owned parked model exited"
                assert time.monotonic() < release_deadline, (
                    "Public source release deadline exceeded; no generation submitted"
                )
                time.sleep(10)
            release = json.loads(source_release.read_bytes())
            assert (
                release["source_manifest_sha256"] == manifest_sha256
                and release["commit"]
            )
            assert (
                hashlib.sha256(
                    (DRIVER / "source-manifest.json").read_bytes()
                ).hexdigest()
                == manifest_sha256
            )
            for name, digest in manifest["files"].items():
                assert (
                    hashlib.sha256((DRIVER / name).read_bytes()).hexdigest() == digest
                ), name
            STATE.pop("current_arm_generation_requests", None)
            STATE.update(phase=arm + "-c8")
            checkpoint()
            service.check()
            service.sidecar_metrics("before-c8")
            folder = OUT / (arm + "-c8-01")
            command = [
                str(ROOT / ".venv/bin/python"),
                "-B",
                str(DRIVER / "continuous.py"),
                "--inputs",
                str(INPUT / "continuous-inputs-r1.json"),
                "--out",
                str(folder),
            ]
            if arm == "pegaflow":
                command += ["--external-metrics-url", "http://127.0.0.1:18390"]
            save(
                OUT / (arm + "-client-command.json"),
                {
                    "argv": command,
                    "external_counter_scope": "Pega restore success counter from vLLM API; independent sidecar snapshots retained",
                },
            )
            log = (OUT / (arm + "-c8-client.log")).open("ab", buffering=0)
            CHILD = subprocess.Popen(
                command,
                cwd=ROOT,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
            CHILD_TICKS = ticks(CHILD)
            code = CHILD.wait()
            STATE["arms"][arm] = {"client_pid": CHILD.pid, "client_exit_code": code}
            checkpoint()
            assert code == 0, "Retained C8 failure; no formal datasets submitted"
            service.check()
            service.sidecar_metrics("after-c8")
            verified = inspect(folder, INPUT / "continuous-inputs-r1.json")
            save(folder / "independent-admission.json", verified)
            STATE["completed_c8_generation_requests"] += verified["total_requests"]
            if arm == "pegaflow":
                save(
                    folder / "independent-external-zero-reuse.json",
                    verify_external(folder),
                )
                mechanism(folder, service.folder)
        STATE["arms"][arm]["owned_service_released"] = True
        checkpoint()
    STATE.update(phase="complete", completed_unix=time.time())
    checkpoint()
    # The formal controller independently re-verifies these receipts and inputs.
    log = (PERSIST / "logs/formal-campaign.log").open("ab", buffering=0)
    child = subprocess.Popen(
        [
            str(ROOT / ".venv/bin/python"),
            "-B",
            str(DRIVER / "campaign81.py"),
            "--out",
            str(PERSIST / "formal-01"),
        ],
        cwd=ROOT,
        stdout=log,
        stderr=subprocess.STDOUT,
        start_new_session=True,
    )
    STATE.update(
        formal_controller_pid=child.pid, formal_controller_started_unix=time.time()
    )
    checkpoint()
except BaseException as error:
    stop_owned(CHILD, CHILD_TICKS)
    STATE.update(
        phase="failed",
        error=type(error).__name__ + ": " + str(error),
        failed_unix=time.time(),
    )
    checkpoint()
    traceback.print_exc()
    raise
