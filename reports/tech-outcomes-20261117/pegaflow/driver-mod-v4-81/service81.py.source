def save(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temp = path.with_suffix(path.suffix + ".tmp")
    temp.write_text(
        json.dumps(value, ensure_ascii=False, indent=2) + "\n", encoding="utf-8"
    )
    temp.replace(path)


def sha(path):
    with Path(path).open("rb") as stream:
        return hashlib.file_digest(stream, "sha256").hexdigest()


def reference(name):
    path, count, expected = QUALIFIED_REFERENCES[name]
    raw = path.read_bytes()
    assert len(raw) == count and hashlib.sha256(raw).hexdigest() == expected, name
    return raw


def release_admission():
    manifest_sha = sha(DRIVER / "source-manifest.json")
    release = json.loads((PERSIST / "publication.json").read_bytes())
    assert release["source_manifest_sha256"] == manifest_sha and release["commit"]
    assert release["readback_verified"] is True
    handoff = json.loads((PERSIST / "resource-handoff.json").read_bytes())
    assert (
        handoff["state"] == "released-for-pegaflow"
        and handoff["machine"] == "ascend-81"
    )
    assert handoff["physical_npus"] == [6, 7] and handoff["logical_npus"] == [0, 1]
    assert (
        handoff["bid_full_released"] is True and handoff["bid_probe_released"] is True
    )
    assert (
        handoff["run_this_host_only"] is True
        and handoff["source_manifest_sha256"] == manifest_sha
    )
    manifest = json.loads((DRIVER / "source-manifest.json").read_bytes())
    for name, expected in manifest["files"].items():
        assert sha(DRIVER / name) == expected, name
    return {
        "manifest_sha256": manifest_sha,
        "publication": release,
        "resource_handoff": handoff,
    }


def runtime_environment():
    result = dict(os.environ)
    result["PYTHONPATH"] = (
        str(ASCEND)
        + ":/vllm-workspace/vllm:/usr/local/Ascend/cann-9.1.0/python/site-packages:/usr/local/Ascend/cann-9.1.0/opp/built-in/op_impl/ai_core/tbe:/usr/local/Ascend/ascend-toolkit/latest/python/site-packages:/usr/local/Ascend/ascend-toolkit/latest/opp/built-in/op_impl/ai_core/tbe:"
    )
    for key in ["PYTHONPATH", "LD_LIBRARY_PATH"]:
        assert not any(
            token in result.get(key, "")
            for token in ["/runtime/official023", "/sources/bidkv-", "bidkv-compat"]
        ), key
    result.update(
        PYTHONDONTWRITEBYTECODE="1",
        HF_HUB_OFFLINE="1",
        VLLM_WORKER_MULTIPROC_METHOD="spawn",
        OMP_NUM_THREADS="2",
        MKL_NUM_THREADS="2",
        TOKENIZERS_PARALLELISM="false",
    )
    return result


def npu():
    return subprocess.check_output(["npu-smi", "info"], text=True, timeout=30)


def ticks(process):
    return Path(f"/proc/{process.pid}/stat").read_text().split()[21]


def stop_owned(process, start_ticks):
    if process is not None and process.poll() is None:
        assert ticks(process) == start_ticks, "PID ownership changed"
        os.killpg(process.pid, signal.SIGTERM)
        try:
            process.wait(timeout=120)
        except subprocess.TimeoutExpired:
            assert ticks(process) == start_ticks
            os.killpg(process.pid, signal.SIGKILL)
            process.wait(timeout=30)


def mapping():
    raw = subprocess.check_output(["npu-smi", "info", "-m"], text=True, timeout=30)
    found = {}
    for line in raw.splitlines():
        words = line.split()
        if (
            len(words) >= 3
            and words[0].isdigit()
            and words[1] == "0"
            and words[2].isdigit()
        ):
            found[int(words[0])] = int(words[2])
    assert [found.get(index) for index in [6, 7]] == [0, 1], (
        "Physical allocation changed; do not guess a mapping"
    )
    return raw


def owned_npus(snapshot, roots):
    observed = set()
    for line in snapshot.splitlines():
        cells = [value.strip() for value in line.split("|")[1:-1]]
        if len(cells) != 5 or not cells[-1].isdigit():
            continue
        device = cells[0].split()
        if len(device) != 2 or not all(value.isdigit() for value in device):
            continue
        observed.add(int(device[0]))
        pid = int(cells[-1])
        for _ in range(32):
            if pid in roots:
                break
            status = Path(f"/proc/{pid}/status")
            assert status.exists(), "NPU process disappeared before ownership admission"
            parent = next(
                int(row.split()[1])
                for row in status.read_text().splitlines()
                if row.startswith("PPid:")
            )
            assert parent > 1 and parent != pid, "Foreign NPU process observed"
            pid = parent
        else:
            raise AssertionError("NPU process ancestry exceeded")
    assert observed == {6, 7}, "Expected both allocated physical6/7 workers"


def identity():
    result = {"release_and_exclusive_resource_admission": release_admission()}
    expected = {
        "torch": "2.10.0+cpu",
        "torch-npu": "2.10.0.post4",
        "vllm": "0.23.0+empty",
        "vllm-ascend": "0.23.0",
        "transformers": "5.5.4",
        "tokenizers": "0.22.2",
    }
    environment = runtime_environment()
    probe = (
        "import importlib.metadata as m,json;print(json.dumps({k:m.version(k)for k in "
        + repr(list(expected))
        + "}))"
    )
    versions = json.loads(
        subprocess.check_output(
            [str(ROOT / ".venv/bin/python"), "-B", "-c", probe],
            env=environment,
            text=True,
            timeout=60,
        )
    )
    assert versions == expected
    result["core_packages"] = versions
    for name, path, commit in [
        ("vllm", "/vllm-workspace/vllm", "0fc695fc6d1d82e9a5ac6835ac8e4e1c83703665"),
        (
            "ascend",
            "/vllm-workspace/vllm-ascend",
            "5cb98caaadeff42b5b62b996e34bb2aaa29d20fd",
        ),
    ]:  # pragma: allowlist secret -- fixed public upstream commits
        head = subprocess.check_output(
            ["git", "-C", path, "rev-parse", "HEAD"], text=True
        ).strip()
        diff = subprocess.check_output(["git", "-C", path, "diff", "--binary", "HEAD"])
        assert head == commit and not diff
        result[name] = {"commit": head, "tracked_diff_empty": True}
    code = """import importlib,inspect,json,hashlib
from pathlib import Path
import vllm
from vllm.v1.core.sched.scheduler import Scheduler
p=Path(inspect.getfile(Scheduler))
assert not hasattr(Scheduler,'_select_bidkv023_victim')
modules={name:str(importlib.import_module(name).__file__)for name in ['pegaflow.pegaflow','pegaflow.npu_ipc_bindings._npu_ipc']}
print('__PF81_IDENTITY__'+json.dumps({'vllm_file':vllm.__file__,'scheduler_file':str(p),'scheduler_sha256':hashlib.sha256(p.read_bytes()).hexdigest(),'bid_bridge_method_present':False,'pegaflow_compiled_modules':modules}))
"""
    observed = subprocess.run(
        [str(ROOT / ".venv/bin/python"), "-B", "-c", code],
        env=environment,
        capture_output=True,
        text=True,
        timeout=180,
    )
    assert observed.returncode == 0, observed.stderr[-2000:]
    imports = json.loads(observed.stdout.rsplit("__PF81_IDENTITY__", 1)[1].strip())
    stock_source = Path("/vllm-workspace/vllm").resolve()
    assert Path(imports["vllm_file"]).resolve().is_relative_to(stock_source / "vllm")
    assert (
        Path(imports["scheduler_file"]).resolve()
        == (stock_source / "vllm/v1/core/sched/scheduler.py").resolve()
    )
    assert imports["scheduler_sha256"] == STOCK_SCHEDULER
    artifact = json.loads(reference("e2-artifact"))["pegaflow"]
    assert (
        artifact["commit"] == "e2cdc2f7b32d8294b54a74545c05d103e5a5ecaf"
    )  # pragma: allowlist secret -- fixed public PegaFlow revision
    package = ROOT / ".venv/lib/python3.12/site-packages/pegaflow"
    for name, digest in artifact["binaries"].items():
        assert sha(package / name) == digest, name
    for path in imports["pegaflow_compiled_modules"].values():
        assert Path(path).resolve().is_relative_to(package.resolve())
        assert (
            sha(path)
            == artifact["binaries"][
                Path(path).resolve().relative_to(package.resolve()).as_posix()
            ]
        )
    result["actual_runtime_imports"] = {
        "actual_returncode": observed.returncode,
        "observation": imports,
        "stdout": observed.stdout,
        "stderr": observed.stderr,
        "scope": "Actual81 stock SDK/compiled module import; no model/NPU/IPC operation invoked",
    }
    result["pegaflow_artifact_provenance"] = {
        "artifact": artifact,
        "scope": "Reuse qualified e2 build bytes only; prior91 model/runtime/C8 results do not qualify this81 campaign",
    }
    from weight_admission import admit

    result["actual81_weight_receipt"] = admit(
        json.loads(reference("81-weights")),
        json.loads(reference("81-expected")),
        MODEL_REVISION,
        str(MODEL),
    )
    assert (DRIVER / "model-expected-weights.json").read_bytes() == reference(
        "81-expected"
    )
    from carrier_admission import verify, imported

    assert (
        sha(ASCEND / "source-admission.json")
        == "55194e2e23ae7a590227ce93508c5c66f8718251952ed7b982d79de2f3f0a1d2"
    )  # pragma: allowlist secret -- same validated common81 carrier receipt
    result["actual_ascend_common_carrier"] = verify(ASCEND)
    result["actual_ascend_import"] = imported(
        ASCEND, ROOT / ".venv/bin/python", environment
    )
    return result


def command(arm):
    argv = [
        str(ROOT / ".venv/bin/python"),
        "-m",
        "vllm.entrypoints.cli.main",
        "serve",
        str(MODEL),
        "--host",
        "127.0.0.1",
        "--port",
        "18390",
        "--served-model-name",
        "qwen3.5-35b",
        "--tensor-parallel-size",
        "2",
        "--pipeline-parallel-size",
        "1",
        "--distributed-executor-backend",
        "mp",
        "--dtype",
        "bfloat16",
        "--max-model-len",
        "65536",
        "--max-num-seqs",
        "16",
        "--max-num-batched-tokens",
        "4096",
        "--kv-cache-memory-bytes",
        str(16 * 1024**3),
        "--gpu-memory-utilization",
        "0.95",
        "--seed",
        "17",
        "--enable-prefix-caching",
        "--mamba-cache-mode",
        "align",
        "--async-scheduling",
        "--enable-prompt-tokens-details",
        "--speculative-config",
        json.dumps({"method": "mtp", "num_speculative_tokens": 2}),
        "--compilation-config",
        json.dumps(
            {
                "cudagraph_mode": "FULL_AND_PIECEWISE",
                "cudagraph_capture_sizes": [3, 6, 12, 24, 48],
                "max_cudagraph_capture_size": 48,
            }
        ),
        "--generation-config",
        "vllm",
        "--override-generation-config",
        json.dumps({"temperature": 0.0, "top_p": 1.0, "top_k": -1}),
        "--default-chat-template-kwargs",
        json.dumps({"enable_thinking": True}),
        "--limit-mm-per-prompt",
        json.dumps({"image": 1, "video": 0}),
        "--additional-config",
        json.dumps({"enable_cpu_binding": True}),
        "--shutdown-timeout",
        "60",
    ]
    if arm == "pegaflow":
        argv += [
            "--kv-transfer-config",
            json.dumps(
                {
                    "kv_connector": "PegaKVConnector",
                    "kv_connector_module_path": "pegaflow.connector",
                    "kv_role": "kv_both",
                    "kv_connector_extra_config": {
                        "pegaflow.mode": "read_write",
                        "pegaflow.model_revision": MODEL_REVISION,
                        "pegaflow.host": "http://127.0.0.1",
                        "pegaflow.port": 18391,
                    },
                }
            ),
        ]
    else:
        assert arm == "native"
    return argv


class Service:
    def __init__(self, arm, folder, name):
        self.arm, self.folder, self.name = arm, Path(folder), name
        self.process = self.sidecar = None
        self.start_ticks = self.sidecar_ticks = None

    def __enter__(self):
        self.folder.mkdir(parents=True, exist_ok=False, mode=0o700)
        try:
            self.start()
            return self
        except BaseException:
            self.__exit__(None, None, None)
            raise

    def start(self):
        begin = time.monotonic()
        save(
            self.folder / "lifecycle-start.json",
            {
                "started_unix": time.time(),
                "started_monotonic": begin,
                "arm": self.arm,
                "scope": "Source admission, sidecar/model loading, graph compilation and CPU binding are preparation costs outside solver timing",
            },
        )
        assert npu().count("No running processes found in NPU") == 2, (
            "Allocated devices are busy"
        )
        (self.folder / "npu-admission.txt").write_text(npu())
        (self.folder / "device-mapping.txt").write_text(mapping())
        before_identity = time.monotonic()
        save(self.folder / "runtime-identity.json", identity())
        save(
            self.folder / "source-admission-cost.json",
            {
                "seconds": time.monotonic() - before_identity,
                "completed_unix": time.time(),
            },
        )
        environment = runtime_environment()
        environment["PYTHONPATH"] = (
            str(ASCEND) + ":" + environment.get("PYTHONPATH", "")
        )
        environment.update(
            {
                "PYTHONDONTWRITEBYTECODE": "1",
                "PYTHONUNBUFFERED": "1",
                "HF_HUB_OFFLINE": "1",
                "VLLM_WORKER_MULTIPROC_METHOD": "spawn",
                "TMPDIR": "/workspace/pf-" + self.name + "-t",
                "VLLM_RPC_BASE_PATH": "/workspace/pf-" + self.name + "-r",
                "VLLM_CACHE_ROOT": str(ROOT / "cache" / self.name / "vllm"),
                "TRITON_CACHE_DIR": str(ROOT / "cache" / self.name / "triton"),
                "TORCHINDUCTOR_CACHE_DIR": str(ROOT / "cache" / self.name / "inductor"),
                "ASCEND_CACHE_PATH": str(ROOT / "cache" / self.name / "ascend"),
                "ASCEND_WORK_PATH": str(ROOT / "logs" / self.name / "ascend"),
            }
        )
        for key in ["TMPDIR", "VLLM_RPC_BASE_PATH"]:
            Path(environment[key]).mkdir(mode=0o700, exist_ok=False)
        if self.arm == "pegaflow":
            sidecar = [
                str(ROOT / ".venv/bin/pegaflow-server"),
                "--addr",
                "127.0.0.1:18391",
                "--http-addr",
                "127.0.0.1:18392",
                "--pool-size",
                "30gb",
                "--devices",
                "0,1",
                "--log-level",
                "info",
            ]
            save(
                self.folder / "sidecar-command.json",
                {"argv": sidecar, "started_unix": time.time()},
            )
            log = (self.folder / "sidecar.log").open("ab", buffering=0)
            self.sidecar = subprocess.Popen(
                sidecar,
                cwd=ROOT,
                env=environment,
                stdout=log,
                stderr=subprocess.STDOUT,
                start_new_session=True,
            )
            self.sidecar_ticks = ticks(self.sidecar)
            self.health(self.sidecar, "http://127.0.0.1:18392/health", 300, False)
        argv = command(self.arm)
        save(
            self.folder / "command.json",
            {
                "argv": argv,
                "environment": {
                    key: environment.get(key)
                    for key in [
                        "PYTHONPATH",
                        "LD_LIBRARY_PATH",
                        "ASCEND_HOME_PATH",
                        "ASCEND_TOOLKIT_HOME",
                        "HF_HUB_OFFLINE",
                        "VLLM_WORKER_MULTIPROC_METHOD",
                        "OMP_NUM_THREADS",
                        "MKL_NUM_THREADS",
                        "TMPDIR",
                        "VLLM_RPC_BASE_PATH",
                        "VLLM_CACHE_ROOT",
                        "TRITON_CACHE_DIR",
                        "TORCHINDUCTOR_CACHE_DIR",
                        "ASCEND_CACHE_PATH",
                        "ASCEND_WORK_PATH",
                        "ASCEND_RT_VISIBLE_DEVICES",
                        "LD_PRELOAD",
                    ]
                },
                "started_unix": time.time(),
            },
        )
        log = (self.folder / "service.log").open("ab", buffering=0)
        self.process = subprocess.Popen(
            argv,
            cwd=ROOT,
            env=environment,
            stdout=log,
            stderr=subprocess.STDOUT,
            start_new_session=True,
        )
        self.start_ticks = ticks(self.process)
        save(
            self.folder / "processes.json",
            {
                "server_pid": self.process.pid,
                "server_start_ticks": self.start_ticks,
                "sidecar_pid": self.sidecar.pid if self.sidecar else None,
                "sidecar_start_ticks": self.sidecar_ticks,
            },
        )
        self.health(self.process, "http://127.0.0.1:18390/health", 1200, True)
        self.binding("startup")
        markers = [
            line
            for line in (self.folder / "service.log")
            .read_text(errors="replace")
            .splitlines()
            if any(
                text in line
                for text in [
                    "Loading weights took",
                    "torch.compile took",
                    "Initial profiling/warmup",
                    "Capturing CUDA graphs",
                    "Graph capturing finished",
                    "Loading drafter model",
                ]
            )
        ]
        save(
            self.folder / "preparation-ready.json",
            {
                "ready_unix": time.time(),
                "total_preparation_seconds": time.monotonic() - begin,
                "compile_and_load_log_observations": markers,
                "scope": "Actual preparation including source admission, sidecar/model init, graph and default binding; not free solver throughput",
            },
        )

    def health(self, process, url, maximum, model):
        begin = time.monotonic()
        advice = []
        last_sample = 0
        while True:
            assert process.poll() is None, "Owned process exited before readiness"
            assert time.monotonic() - begin < maximum, (
                "Original startup deadline exceeded"
            )
            if time.monotonic() - last_sample >= 10:
                self.startup_sample("model" if model else "sidecar")
                last_sample = time.monotonic()
            log_path = self.folder / ("service.log" if model else "sidecar.log")
            if log_path.exists():
                with log_path.open("rb") as stream:
                    stream.seek(max(0, log_path.stat().st_size - 65536))
                    tail = stream.read().decode(errors="replace")
                needles = [
                    "EngineCore failed to start",
                    "Engine core initialization failed",
                    "WorkerProc failed to start",
                    "NPUModelRunner init failed",
                    "NPUGraph: ERROR",
                    "register_context_batch RPC failed",
                    "Worker failed with error",
                    "ValueError: To serve at least one request",
                ]
                fatal = next((needle for needle in needles if needle in tail), None)
                if fatal is not None:
                    save(
                        self.folder / "startup-fatal.json",
                        {
                            "observed": fatal,
                            "elapsed_seconds": time.monotonic() - begin,
                            "log_sha256": sha(log_path),
                            "scope": "Observed fatal startup; do not wait for an orphaned API parent or submit generation",
                        },
                    )
                    raise RuntimeError(
                        "Owned startup reported "
                        + fatal
                        + "; inspect retained service log"
                    )
            if model:
                stats = {
                    k: int(v)
                    for k, v in (
                        line.split()
                        for line in Path("/sys/fs/cgroup/memory.stat")
                        .read_text()
                        .splitlines()
                    )
                }
                if stats["file"] > 16 * 1024**3:
                    for item in json.loads(
                        (DRIVER / "model-expected-weights.json").read_bytes()
                    ):
                        descriptor = os.open(MODEL / item["path"], os.O_RDONLY)
                        try:
                            os.posix_fadvise(descriptor, 0, 0, os.POSIX_FADV_DONTNEED)
                        finally:
                            os.close(descriptor)
                    advice.append(
                        {
                            "elapsed": time.monotonic() - begin,
                            "file_cache_before": stats["file"],
                            "memory_current_after": Path(
                                "/sys/fs/cgroup/memory.current"
                            ).read_text(),
                        }
                    )
                    save(self.folder / "startup-cache-advice.json", advice)
            try:
                with urllib.request.urlopen(url, timeout=5) as response:
                    assert response.status == 200
                break
            except Exception:
                time.sleep(2)
        self.startup_sample("model" if model else "sidecar")
        save(
            self.folder / ("ready-model.json" if model else "ready-sidecar.json"),
            {"healthy_unix": time.time(), "startup_seconds": time.monotonic() - begin},
        )

    def startup_sample(self, label):
        row = {
            "wall": time.time(),
            "monotonic": time.monotonic(),
            "phase": label + "-initialization",
        }
        for name in ["memory.current", "memory.stat", "memory.events", "cpu.stat"]:
            row[name] = Path("/sys/fs/cgroup", name).read_text()
        try:
            row["npu_smi"] = npu()
        except Exception as error:
            row["sampling_error"] = type(error).__name__ + ": " + str(error)
        with (self.folder / ("startup-" + label + "-telemetry.jsonl")).open(
            "a", encoding="utf-8"
        ) as stream:
            stream.write(json.dumps(row) + "\n")

    def binding(self, label):
        raw = npu()
        roots = {self.process.pid}
        if self.sidecar is not None:
            roots.add(self.sidecar.pid)
        owned_npus(raw, roots)
        pids = set(roots)
        for line in raw.splitlines():
            cells = [value.strip() for value in line.split("|")[1:-1]]
            if len(cells) == 5 and cells[-1].isdigit():
                pids.add(int(cells[-1]))
        rows = []
        for pid in sorted(pids):
            process = Path("/proc") / str(pid)
            tasks = []
            for task in sorted((process / "task").glob("[0-9]*")):
                try:
                    tasks.append(
                        {
                            "task_id": int(task.name),
                            "name": (task / "comm").read_text().strip(),
                            "allowed_cpus": sorted(
                                os.sched_getaffinity(int(task.name))
                            ),
                        }
                    )
                except (ProcessLookupError, FileNotFoundError):
                    continue
            rows.append(
                {
                    "pid": pid,
                    "process_allowed_cpus": sorted(os.sched_getaffinity(pid)),
                    "threads": tasks,
                }
            )
        lines = (self.folder / "service.log").read_text(errors="replace").splitlines()
        markers = [
            line
            for line in lines
            if any(
                text in line
                for text in [
                    "cpu_binding.py",
                    "Bind cpus failed",
                    "CPU binding skipped",
                ]
            )
        ]
        skipped = any(
            "bind cpus failed" in line.lower() or "cpu binding skipped" in line.lower()
            for line in markers
        )
        save(
            self.folder / ("cpu-binding-" + label + ".json"),
            {
                "checked_unix": time.time(),
                "requested_enable_cpu_binding": True,
                "upstream_default": True,
                "binding_log_markers": markers,
                "warning_or_skip_seen": skipped,
                "processes": rows,
                "cpu_max": Path("/sys/fs/cgroup/cpu.max").read_text().strip(),
                "cpuset_effective": Path("/sys/fs/cgroup/cpuset.cpus.effective")
                .read_text()
                .strip(),
                "interpretation": "Record actual thread affinity and warnings; a true configuration flag alone does not prove binding succeeded",
            },
        )
        assert not skipped, (
            "Requested default CPU binding was skipped; retain zero-generation evidence and diagnose before inference"
        )

    def sidecar_metrics(self, name):
        if self.arm == "pegaflow":
            with urllib.request.urlopen(
                "http://127.0.0.1:18392/metrics", timeout=30
            ) as response:
                (self.folder / (name + "-sidecar-metrics.txt")).write_bytes(
                    response.read()
                )

    def check(self):
        assert (
            self.process.poll() is None and ticks(self.process) == self.start_ticks
        ), "Model process no longer owned/alive"
        raw = npu()
        roots = {self.process.pid}
        if self.sidecar is not None:
            roots.add(self.sidecar.pid)
        owned_npus(raw, roots)
        (self.folder / "last-owned-npu.txt").write_text(raw)
        self.binding("last")
        if self.sidecar is not None:
            assert (
                self.sidecar.poll() is None
                and ticks(self.sidecar) == self.sidecar_ticks
            )
            from observation import totals

            with urllib.request.urlopen(
                "http://127.0.0.1:18390/metrics", timeout=30
            ) as response:
                metrics = totals(response.read().decode())
            keys = [
                key
                for key in metrics
                if key.endswith(("pega_load_failure_total", "pega_save_failure_total"))
            ]
            assert len(keys) == 2 and all(metrics[key] == 0 for key in keys), (
                "Pega failure evidence missing or nonzero"
            )
        save(
            self.folder / "last-owned-check.json",
            {"checked_unix": time.time(), "server_pid": self.process.pid},
        )

    def __exit__(self, *args):
        stop_owned(self.process, self.start_ticks)
        stop_owned(self.sidecar, self.sidecar_ticks)
        save(
            self.folder / "stop.json",
            {
                "stopped_unix": time.time(),
                "server_exit_code": self.process.poll() if self.process else None,
                "sidecar_exit_code": self.sidecar.poll() if self.sidecar else None,
            },
        )
        begin = time.monotonic()
        while True:
            raw = npu()
            (self.folder / "npu-release.txt").write_text(raw)
            if raw.count("No running processes found in NPU") == 2:
                break
            assert time.monotonic() - begin < 90, (
                "Owned mappings did not release after exit"
            )
            time.sleep(2)
