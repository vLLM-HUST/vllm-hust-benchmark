OLD = Path("/data/shared_upload/cybber695/pegaflow-techoutcomes-20261113-02")
BIDNAS = Path("/data/shared_upload/cybber695/bidkv-five-datasets-20261113-01")
MODEL_REVISION = "712cf74392b05026a6db2bf213d343747d1f6d45"  # pragma: allowlist secret -- fixed public model revision
STOCK_SCHEDULER = "9ae1491f57a6294e32416b93ef2ea68107fa0d65c3a4d7f745f1261012f735e9"  # pragma: allowlist secret -- official stock source identity
QUALIFIED_REFERENCES = {
    "e2-artifact": (
        OLD / "evidence/formal-runtime-identity.json",
        7816,
        "6580cb0025e8559cb6294593df203fc70e410953f6c9d9ae7679a76f57b4f923",
    ),
    "81-weights": (
        BIDNAS / "provenance/model-hash-status.json",
        5084,
        "e95e919abc6d13f160ca7530211ec167945a2d3981aa36c48003bbd9ade5b6c8",
    ),
    "81-expected": (
        BIDNAS / "provenance/model-expected-weights.json",
        2453,
        "1fec52d80a8898b730f32bd498a7ce9f90a31d6b6cc15d833611cd271fdce0d3",
