"""Semantic protocol checks using synthetic HTTP only; no model requests."""

import base64
import gzip
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
import json
from pathlib import Path
import threading
import time

import pytest

from measurement import percentile, summarize
from observation import zero_reuse
from transport import call


def row(identity, start, first, end, tokens):
    return {'case_id': identity, 'status': 'ok', 'start': {'monotonic': start},
            'first_token': {'monotonic': first}, 'end': {'monotonic': end},
            'usage': {'completion_tokens': tokens}, 'finish_reason': 'stop'}


def test_overlapping_batch_and_one_token_exclusion():
    report = summarize(['a', 'b'], [row('a', 0, 2, 10, 9), row('b', 1, 4, 11, 1)])
    assert report['output_tokens_per_second'] == 10/11
    assert report['tpot_seconds']['mean'] == 1
    assert report['tpot_seconds']['samples'] == 1
    assert report['tpot_excluded_output_tokens_le_one'] == 1
    assert report['ttft_seconds']['mean'] == 2.5


def test_missing_is_not_fabricated_zero():
    report = summarize(['missing'], [])
    assert report['output_tokens_per_second'] is None
    assert report['not_executed'] == 1
    assert not report['valid_transport']
    with pytest.raises(ValueError):
        summarize(['a'], [row('a', 0, 1, 2, 2)]*2)
    assert percentile([0, 10], .95) == 9.5


def test_null_cache_requires_counter_proof_and_unique_salts():
    records = [{'request': {'cache_salt': 'a'}, 'cached_tokens_reported': None}]
    before = 'vllm:prefix_cache_hits_total{model_name="x"} 0\n'
    assert zero_reuse(before, before, records)['passed']
    with pytest.raises(ValueError):
        zero_reuse(before, before.replace('} 0', '} 1'), records)
    with pytest.raises(ValueError):
        zero_reuse(before, before, records*2)
    with pytest.raises(ValueError):
        zero_reuse('', '', records)
    with pytest.raises(ValueError):
        zero_reuse(before, before, records, external_metrics=('pega_load_success_total 0', 'pega_load_success_total 1'))


@pytest.fixture
def server():
    class Handler(BaseHTTPRequestHandler):
        events = []
        delay = 0

        def log_message(self, *args):
            pass

        def do_POST(self):
            self.rfile.read(int(self.headers['Content-Length']))
            self.send_response(200)
            self.send_header('Content-Type', 'text/event-stream')
            self.end_headers()
            try:
                for event in self.events:
                    self.wfile.write(b'data: '+(event.encode() if isinstance(event, str) else json.dumps(event).encode())+b'\n\n')
                    self.wfile.flush()
                    time.sleep(self.delay)
            except (BrokenPipeError, ConnectionResetError):
                pass
    http = ThreadingHTTPServer(('127.0.0.1', 0), Handler)
    thread = threading.Thread(target=http.serve_forever, daemon=True)
    thread.start()
    yield Handler, {'base_url': 'http://127.0.0.1:'+str(http.server_port), 'timeout': 2}
    http.shutdown()
    http.server_close()
    thread.join()


def events(*, cached=None, finish='stop', tokens=1):
    return [{'choices': [{'delta': {'content': 'A'}, 'finish_reason': None}]},
            {'choices': [{'delta': {}, 'finish_reason': finish}]},
            {'choices': [], 'usage': {'prompt_tokens': 3, 'completion_tokens': tokens, 'prompt_tokens_details': cached}}, '[DONE]']


def body():
    return {'model': 'synthetic', 'messages': [], 'stream': True,
            'stream_options': {'include_usage': True}, 'max_completion_tokens': 8}


def test_natural_eos_nullable_details_and_exact_wire(server, tmp_path):
    handler, config = server
    handler.events = events()
    result = call(config, body(), tmp_path)
    assert result['status'] == 'ok'
    assert result['usage']['completion_tokens'] == 1
    assert result['cached_tokens_reported'] is None
    with gzip.open(result['stream_capture'], 'rt') as stream:
        wire = b''.join(base64.b64decode(json.loads(line)['raw_b64']) for line in stream)
    assert wire.endswith(b'data: [DONE]\n\n')
    assert call(config, body(), tmp_path, fixed_length=True)['status'] != 'ok'


@pytest.mark.parametrize('scenario', ['cached', 'error', 'incomplete', 'short_length'])
def test_invalid_streams_retained(server, tmp_path, scenario):
    handler, config = server
    handler.events = events(cached={'cached_tokens': 2}) if scenario == 'cached' else events()
    if scenario == 'error':
        handler.events = [{'error': {'message': 'synthetic failure'}}]
    elif scenario == 'incomplete':
        handler.events = events()[:-1]
    elif scenario == 'short_length':
        handler.events = events(finish='length')
    result = call(config, body(), tmp_path)
    assert result['status'] != 'ok'
    assert result['error'] and Path(result['stream_capture']).is_file()


def test_whole_request_deadline_includes_stream(server, tmp_path):
    handler, config = server
    handler.events = events()
    handler.delay = .1
    config['timeout'] = .15
    result = call(config, body(), tmp_path)
    assert result['status'] != 'ok'
    assert result['elapsed_s'] < .4
