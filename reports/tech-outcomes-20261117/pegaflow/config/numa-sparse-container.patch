+
+fn npu_device_ids_from_nodes<I, S>(names: I) -> Vec<u32>
+where
+    I: IntoIterator<Item = S>,
+    S: AsRef<str>,
+{
+    let mut devices: Vec<u32> = names
+        .into_iter()
+        .filter_map(|name| name.as_ref().strip_prefix("davinci")?.parse().ok())
+        .collect();
+    devices.sort_unstable();
+    devices.dedup();
+    devices
+}
+
+#[cfg(test)]
+mod sparse_container_device_tests {
+    use super::npu_device_ids_from_nodes;
+
+    #[test]
+    fn sparse_device_nodes_preserve_physical_ids_and_ignore_control_nodes() {
+        assert_eq!(
+            npu_device_ids_from_nodes([
+                "davinci7",
+                "davinci_manager",
+                "davinci0",
+                "davinci7",
+                "davinci0_mng",
+                "unrelated",
+            ]),
+            vec![0, 7]
+        );
+        assert!(npu_device_ids_from_nodes(["davinci_manager", "davinci"]).is_empty());
+    }
 }
 
