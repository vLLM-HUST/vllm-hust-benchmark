"""Historical PegaFlow evidence audit: CPU only; never starts an engine/model."""

import argparse
import hashlib
import importlib.util
import json
import os
from pathlib import Path
import subprocess
import sys
import time
import traceback

NAS = Path('/data/shared_upload/cybber695')
CAMPAIGN = NAS / 'pegaflow91-five-datasets-20261114-04'
DRIVER = CAMPAIGN / 'sources/pegaflow91-mod-v4-final01'
ANALYSIS = CAMPAIGN / 'sources/pegaflow91-analysis-v4'
COMMON = NAS / 'five-datasets-20261113-v1-controlled'
FORMAL = CAMPAIGN / 'formal-01'
OUT = NAS / 'final-closeout-20261116/pegaflow-audit'
PYTHON = '/usr/local/python3.12.13/bin/python3'
MAIN_SHA = '8e4ef4748eafd8ad0cdc6fd0c1d82df471576357cca2333ce1abc4abe168c34e'
EXTRA_SHA = '782cecbbaac0757f388ece22f335dcceefb19bfb83345f79a1fa27ffbaa8b408'


def sha(path):
    with Path(path).open('rb') as stream:
        return hashlib.file_digest(stream, 'sha256').hexdigest()


def read(path):
    return json.loads(Path(path).read_bytes())


def save(path, value):
    path = Path(path)
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix(path.suffix + '.tmp')
    temporary.write_text(json.dumps(value, ensure_ascii=False, indent=2, allow_nan=False) + '\n', encoding='utf-8', newline='\n')
    temporary.replace(path)


STATE = {'schema': 'pegaflow-historical-cpu-audit/v1', 'phase': 'starting', 'started_unix': time.time(), 'pid': os.getpid(), 'model_startups': 0, 'model_generation_requests': 0, 'new_experiments': 0, 'steps': []}


def checkpoint():
    save(OUT / 'audit-status.json', STATE)


def invoke(name, argv):
    row = {'name': name, 'argv': argv, 'started_unix': time.time()}
    STATE['phase'] = name
    STATE['steps'].append(row)
    checkpoint()
    with (OUT / 'controlled-logs' / (name + '.log')).open('wb') as log:
        process = subprocess.Popen(argv, stdout=log, stderr=subprocess.STDOUT, env={**os.environ, 'PYTHONDONTWRITEBYTECODE': '1', 'TMPDIR': str(OUT / 'tmp')})
        row['pid'] = process.pid
        row['actual_returncode'] = process.wait()
    row['completed_unix'] = time.time()
    row['controlled_log_sha256'] = sha(OUT / 'controlled-logs' / (name + '.log'))
    checkpoint()
    assert row['actual_returncode'] == 0, name + ' retained failure; see controlled log'


def source_admission(root, manifest, expected):
    assert sha(root / manifest) == expected
    files = read(root / manifest)['files']
    for name, digest in files.items():
        assert sha(root / name) == digest, name
    return {'manifest_sha256': expected, 'files_verified': len(files)}


def raw_inventory():
    rows = []
    for folder in [CAMPAIGN / 'metadata', CAMPAIGN / 'qualification', CAMPAIGN / 'logs', FORMAL]:
        for path in sorted(folder.rglob('*')):
            if path.is_file():
                rows.append({'path': path.relative_to(CAMPAIGN).as_posix(), 'bytes': path.stat().st_size, 'sha256': sha(path)})
    return rows


def main():
    os.umask(0o077)
    assert sys.executable == PYTHON and sys.version_info[:3] == (3, 12, 13), sys.executable
    for name in ['tmp', 'controlled-logs', 'verification', 'quality-recomputed']:
        (OUT / name).mkdir(parents=True, exist_ok=False)
    checkpoint()
    source = {'driver': source_admission(DRIVER, 'source-manifest.json', MAIN_SHA), 'analysis': source_admission(ANALYSIS, 'analysis-manifest.json', EXTRA_SHA)}
    STATE['source_admission'] = source
    # Restore only the original absolute evidence pathname, not its former SDK.
    scratch = Path('/workspace/pegaflow91-five-datasets-20261114-04')
    scratch.mkdir(mode=0o700, exist_ok=True)
    mappings = []
    for name, target in [('durable', CAMPAIGN), ('logs', CAMPAIGN / 'logs'), ('evidence', CAMPAIGN / 'evidence')]:
        assert target.resolve().is_relative_to(NAS.resolve()) and target.is_dir()
        path = scratch / name
        if path.is_symlink():
            assert path.resolve() == target.resolve()
        else:
            assert not path.exists(), 'Refuse to replace an existing scratch path'
            path.symlink_to(target, target_is_directory=True)
        mappings.append({'path': str(path), 'target': str(target.resolve()), 'symlink_only': True})
    save(OUT / 'evidence-path-mapping.json', {'mappings': mappings, 'scope': 'Historical absolute stream capture path resolution only; no SDK/runtime/model restored'})
    STATE['phase'] = 'original-inventory-before'
    checkpoint()
    original_before = raw_inventory()
    save(OUT / 'original-inventory-before.json', original_before)
    frozen_manifest = read(FORMAL / 'manifest.json')
    for item in frozen_manifest['files']:
        path = FORMAL / item['path']
        assert path.is_file() and path.stat().st_size == item['bytes'] and sha(path) == item['sha256'], item['path']
    STATE['original_formal_manifest_files_verified'] = len(frozen_manifest['files'])
    state = read(FORMAL / 'execution-checklist.json')
    assert state['phase'] == 'completed' and state['formal_complete'] is True
    assert state['planned_solver_requests_per_arm'] == 672 and state['planned_judge_inputs'] == 720
    assert len(state['stages']) == 14 and all(row['status'] == 'completed' and row['exit_code'] == 0 for row in state['stages'])
    for stage in state['stages']:
        name = stage['name']
        argv = [PYTHON, '-B', str(ANALYSIS / 'verify_pegaflow_finite.py'), '--driver', str(DRIVER), '--tools', str(COMMON / 'reference-tools'), '--plan', str(COMMON / 'plans' / stage['dataset']), '--root', str(FORMAL / name), '--out', str(OUT / 'verification' / (name + '.json')), '--dataset', stage['dataset'], '--arm', stage['arm'], '--stage', stage['stage']]
        if stage['stage'] == 'judge':
            argv += ['--responses', str(FORMAL / (stage['solver_arm'] + '-' + stage['dataset']) / 'evaluation')]
        invoke('verify-' + name, argv)
    invoke('verify-and-export-c8', [PYTHON, '-B', str(ANALYSIS / 'export_pegaflow_c8.py'), '--campaign', str(CAMPAIGN), '--driver', str(DRIVER), '--inputs', str(NAS / 'bidkv-five-datasets-20261113-01/controlled/initial-inputs-01/continuous-inputs-r1.json'), '--out', str(OUT / 'c8-numeric')])
    qualities = []
    for dataset in ['hle', 'frontier']:
        for arm in ['native', 'pegaflow']:
            name = 'quality-' + arm + '-' + dataset
            destination = OUT / 'quality-recomputed' / name
            invoke('recompute-' + name, [PYTHON, '-B', str(DRIVER / 'finite.py'), '--dataset', dataset, '--stage', 'quality', '--tools', str(COMMON / 'reference-tools'), '--plan', str(COMMON / 'plans' / dataset), '--out', str(destination), '--responses', str(FORMAL / (arm + '-' + dataset) / 'evaluation'), '--grades', str(FORMAL / ('judge-' + arm + '-' + dataset) / 'evaluation')])
            original = FORMAL / name / 'quality/summary.json'
            actual = destination / 'quality/summary.json'
            result = {'name': name, 'original_sha256': sha(original), 'recomputed_sha256': sha(actual), 'byte_identical': original.read_bytes() == actual.read_bytes(), 'json_identical': read(original) == read(actual)}
            qualities.append(result)
            save(OUT / 'quality-recomputation.json', qualities)
            assert result['json_identical'], 'Original grader CPU summary changed: ' + name
    invoke('export-full-five-numeric', [PYTHON, '-B', str(ANALYSIS / 'export_pegaflow_numeric.py'), '--root', str(FORMAL), '--out', str(OUT / 'numeric'), '--common', str(COMMON), '--verification', str(OUT / 'verification')])
    invoke('build-connector-cost-supplement', [PYTHON, '-B', str(ANALYSIS / 'build_pegaflow_supplement.py'), '--capsule', str(OUT / 'numeric'), '--out', str(OUT / 'connector-supplement')])
    STATE['phase'] = 'original-inventory-after'
    checkpoint()
    original_after = raw_inventory()
    save(OUT / 'original-inventory-after.json', original_after)
    assert original_before == original_after, 'Original controlled files changed during CPU audit'
    checks = [read(OUT / 'verification' / (stage['name'] + '.json')) for stage in state['stages']]
    closure = {'schema': 'pegaflow-historical-cpu-closure/v1', 'all_stages_passed': True, 'formal_stages': len(checks), 'planned_solver_requests': 1344, 'planned_judge_inputs': 720, 'verified_records': sum(row['recorded'] for row in checks), 'raw_sse_verified': sum(row['raw_sse_verified'] for row in checks), 'original_manifest_files_verified': len(frozen_manifest['files']), 'original_inventory_files': len(original_before), 'original_inventory_unchanged': True, 'quality_recomputation': qualities, 'source_admission': source, 'c8_summary': read(OUT / 'c8-numeric/paired-summary.json'), 'actual_execution_receipts': read(OUT / 'numeric/actual-execution-receipts.json'), 'model_startups': 0, 'model_generation_requests': 0, 'new_experiments': 0, 'checked_unix': time.time()}
    assert closure['verified_records'] == 2064
    save(OUT / 'closure.json', closure)
    STATE.update(phase='completed', completed_unix=time.time(), actual_returncode=0, verified_records=closure['verified_records'], raw_sse_verified=closure['raw_sse_verified'], original_inventory_unchanged=True)
    checkpoint()
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as error:
        STATE.update(phase='failed', failed_unix=time.time(), actual_returncode=2, error=type(error).__name__ + ': ' + str(error))
        checkpoint()
        traceback.print_exc()
        raise SystemExit(2)
