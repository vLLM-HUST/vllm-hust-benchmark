+"""Migrated symlink payloads retain the observer's content identity fence."""
+import hashlib
+import sys
+from pathlib import Path
+from types import ModuleType, SimpleNamespace
+
+import pytest
+
+from draft_length_runtime import load_snapshot, resolved_payload_hashes
+
+
+def test_real_migrated_payload_retains_all_pins():
+    from draft_length_runtime import PAYLOAD_HASHES
+    result = resolved_payload_hashes()
+    assert len(result) == len(PAYLOAD_HASHES) == 3
+    for name, digest in PAYLOAD_HASHES.items():
+        assert result[str(Path(name).resolve(strict=True))] == digest
+
+
+def test_original_observer_installs_with_migrated_paths(tmp_path, monkeypatch):
+    actual = tmp_path / 'restored'
+    actual.mkdir()
+    alias = tmp_path / 'logical'
+    alias.symlink_to(actual, target_is_directory=True)
+    pins = {}
+    modules = []
+    for filename in ('wave.py', 'owned.py', 'draft_fia.py'):
+        source = actual / filename
+        source.write_text('# pinned source\n')
+        pins[str(alias / filename)] = hashlib.sha256(source.read_bytes()).hexdigest()
+        modules.append(SimpleNamespace(__file__=str(alias / filename)))
+    wave, owned, draft = modules
+    wave.Frame = type('Frame', (), {'prepare': lambda *args: None})
+    owned.enabled = lambda: True
+    fia = ModuleType('betterscale.patches.qwen_fia')
+    fia.wave, fia.owned = wave, owned
+    qwen = ModuleType('betterscale.models.qwen35')
+    qwen.draft_fia = draft
+    monkeypatch.setitem(sys.modules, fia.__name__, fia)
+    monkeypatch.setitem(sys.modules, qwen.__name__, qwen)
+    observer = load_snapshot()
+    with pytest.raises(KeyError):
+        observer.install(None, None, lambda *a, **kw: None, lambda: True, pins)
+    events = []
+    normalized = resolved_payload_hashes(pins)
+    observer.install(None, None, lambda kind, **fields: events.append((kind, fields)),
+                     lambda: True, normalized)
+    assert wave.Frame.prepare._hust_owned_fia_snapshot is True
+    assert events[0][1]['source_sha256'] == normalized
+    # The original observer still independently rejects later content changes.
+    (actual / 'wave.py').write_text('# changed after normalization\n')
+    with pytest.raises(ValueError, match='source differs'):
+        observer.install(None, None, lambda *a, **kw: None, lambda: True, normalized)
+
+
+def test_changed_payload_rejected(tmp_path):
+    path = tmp_path / 'wave.py'
+    path.write_text('changed')
+    with pytest.raises(ValueError, match='source differs'):
+        resolved_payload_hashes({str(path): hashlib.sha256(b'original').hexdigest()})
+
+
+def test_conflicting_aliases_rejected(tmp_path):
+    path = tmp_path / 'wave.py'
+    path.write_text('original')
+    alias = tmp_path / 'alias.py'
+    alias.symlink_to(path)
+    with pytest.raises(ValueError, match='Conflicting'):
+        resolved_payload_hashes({str(path): hashlib.sha256(b'original').hexdigest(),
+                                 str(alias): '0' * 64})
+
+
+def test_missing_payload_rejected(tmp_path):
+    with pytest.raises(FileNotFoundError):
+        resolved_payload_hashes({str(tmp_path / 'missing.py'): '0' * 64})
