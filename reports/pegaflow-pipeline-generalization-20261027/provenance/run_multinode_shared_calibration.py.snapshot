"""Calibrate incremental restores from all 32 designated calibration inputs."""

import asyncio
import json
import time

import httpx

import calibration_runner_gated3 as runner


async def main():
    source=[json.loads(l) for l in (runner.ROOT/'requests.jsonl').read_text().splitlines()]
    rows=sorted((r for r in source if r['split']=='calibration'),key=lambda r:(r['step_id'],r['task']))
    tasks=sorted({r['task'] for r in rows});results={}
    async with httpx.AsyncClient(limits=httpx.Limits(max_connections=128,max_keepalive_connections=64),timeout=240,trust_env=False) as client:
        for repeat in range(2):
            plans=[];previous={}
            for index,row in enumerate(rows):
                plans.append({'row':row,'P':f"P{tasks.index(row['task'])%2}",'output':128,'at':index/2,
                              'salt':f'train32-shared-{repeat}','previous':previous.get(row['task'])})
                previous[row['task']]=index
            label=f'train32-shared-r{repeat}'
            results[label]=await runner.condition(client,plans,label)
            (runner.ROOT/'shared32-summary.json').write_text(json.dumps(results,indent=2))
    (runner.ROOT/'shared32-done.json').write_text(json.dumps({'epoch_ns':time.time_ns()}))


if __name__=='__main__':
    try:asyncio.run(main())
    except BaseException as error:
        import traceback
        (runner.ROOT/'shared32-failure.json').write_text(json.dumps({'error':str(error),'traceback':traceback.format_exc()}))
        raise
