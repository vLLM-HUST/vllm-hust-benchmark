{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vllm-hust/vllm-hust-benchmark/schemas/fixed_target_registry_v1.schema.json",
  "title": "Fixed-Target Registry v1",
  "description": "Registry of fixed benchmark target profiles for the official Ascend campaign. Active/retired profiles must record effective server parameters; specialty placeholders may omit them.",
  "type": "object",
  "required": [
    "schema_version",
    "profiles"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "fixed-target-registry/v1"
    },
    "profiles": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "profile": {
      "type": "object",
      "required": [
        "target_id",
        "target_version",
        "profile_name",
        "model",
        "hardware_chip_model",
        "chip_count",
        "model_precision",
        "tensor_parallel_size",
        "workload_name",
        "status"
      ],
      "properties": {
        "target_id": {
          "type": "string",
          "minLength": 1
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "profile_name": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "hardware_chip_model": {
          "type": "string",
          "minLength": 1
        },
        "chip_count": {
          "type": "integer",
          "minimum": 1
        },
        "model_precision": {
          "type": "string",
          "minLength": 1
        },
        "tensor_parallel_size": {
          "type": "integer",
          "minimum": 1
        },
        "gpu_memory_utilization": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "max_model_len": {
          "type": "integer",
          "minimum": 1
        },
        "workload_name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "retired",
            "specialty"
          ]
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "active",
                  "retired"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "gpu_memory_utilization",
              "max_model_len"
            ]
          }
        }
      ]
    }
  }
}
