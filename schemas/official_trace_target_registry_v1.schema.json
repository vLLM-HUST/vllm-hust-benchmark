{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "registry_version", "effective_from", "targets"],
  "properties": {
    "schema_version": {"const": "official-trace-target-registry/v1"},
    "registry_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "effective_from": {"type": "string", "format": "date"},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "status", "intended_use", "source", "format", "replay_contract"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "title": {"type": "string", "minLength": 1},
          "status": {"enum": ["provisional", "active", "retired"]},
          "intended_use": {"const": "specialty-trace-replay"},
          "source": {
            "type": "object",
            "required": ["repository", "release", "asset", "url", "size_bytes", "sha256", "license", "citation"],
            "properties": {
              "repository": {"type": "string", "format": "uri"},
              "release": {"type": "string", "minLength": 1},
              "asset": {"type": "string", "minLength": 1},
              "url": {"type": "string", "format": "uri"},
              "size_bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "license": {"const": "CC-BY-4.0"},
              "citation": {"type": "string", "format": "uri"}
            },
            "additionalProperties": false
          },
          "format": {"type": "object"},
          "replay_contract": {"type": "object"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
