{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://vllm-hust.sage.org.ai/data/schemas/plugin_workload_navigation_v1.schema.json",
  "title": "Plugin Workload navigation v1",
  "type": "object",
  "required": ["schema_version", "traits", "plugins"],
  "properties": {
    "schema_version": {"const": "plugin-workload-navigation/v1"},
    "traits": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["label_en", "label_zh", "description_en", "description_zh"],
        "properties": {
          "label_en": {"type": "string", "minLength": 1},
          "label_zh": {"type": "string", "minLength": 1},
          "description_en": {"type": "string", "minLength": 1},
          "description_zh": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "plugins": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
      }
    }
  },
  "additionalProperties": false
}
