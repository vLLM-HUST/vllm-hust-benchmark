#!/usr/bin/env python3
"""Run frozen vLLM-HUST inference tests and recompute metrics from the recorded runs."""

import argparse
import hashlib
import json
import math
import os
import re
import shutil
import statistics
import subprocess
import sys
from datetime import datetime, timezone
from pathlib import Path, PurePosixPath

from inference_test_report import SECTIONS, disposition, plotter, write_report

DATASETS = {"MMLU-Pro", "HLE-Verified", "SWE-bench Pro V1", "FrontierScience", "Terminal-Bench 2.1"}
PAIR = ("B0", "B1")
CONTEXT = ("4K", "16K")
ROLES = {
    "compute": ("effective_config", "work_ledger", "timing", "calibration", "whole_chain", "reference_review"),
    "throughput": ("effective_config", "service_log", "requests", "quality_review", "slo_review"),
    "latency": ("effective_config", "service_log", "requests", "quality_review", "slo_review"),
    "stability": ("effective_config", "service_log", "requests", "task_results", "incident_review"),
    "context": ("effective_config", "service_log", "requests", "incident_review"),
    "cost": ("effective_config", "service_log", "requests", "quality_review", "slo_review", "fee_basis", "utilization"),
}
TAILS = ("ttft_p95_ms", "ttft_p99_ms", "tpot_p95_ms", "tpot_p99_ms")
INCIDENTS = ("oom", "deadlock", "unexpected_exit", "silent_truncation")
THRESHOLDS = {
    "compute_efficiency_pct": 50,
    "throughput_gain_pct": 10,
    "latency_improvement_pct": 5,
    "cost_reduction_pct": 10,
}


def require(condition, message):
    if not condition:
        raise ValueError(message)


def number(value, label, *, positive=False, maximum=None):
    require(type(value) in (int, float) and math.isfinite(value), f"{label}: finite number required")
    require((value > 0 if positive else value >= 0) and (maximum is None or value <= maximum),
            f"{label}: out of range")
    return value


def count(value, label):
    require(type(value) is int and value >= 0, f"{label}: nonnegative integer required")
    return value


def json_read(path):
    return json.loads(path.read_text(encoding="utf-8-sig"))


def json_write(path, value):
    path.write_text(json.dumps(value, ensure_ascii=False, allow_nan=False, indent=2) + "\n", encoding="utf-8")


def sha256(path):
    with path.open("rb") as file:
        return hashlib.file_digest(file, "sha256").hexdigest()


def local_file(root, relative):
    require(isinstance(relative, str) and relative and "\\" not in relative and ":" not in relative,
            f"Invalid relative path: {relative}")
    path = PurePosixPath(relative)
    require(not path.is_absolute() and ".." not in path.parts, f"Invalid relative path: {relative}")
    result = root.joinpath(*path.parts).resolve()
    require(result.is_relative_to(root.resolve()) and result.is_file(), f"File missing or outside root: {relative}")
    return result


def lock(root, relative, expected):
    path = local_file(root, relative)
    require(isinstance(expected, str) and re.fullmatch(r"[0-9a-f]{64}", expected) is not None,
            f"SHA-256 missing or malformed: {relative}")
    require(sha256(path) == expected, f"SHA-256 mismatch: {relative}")
    return path


def expected_arms(case):
    if case["kind"] == "context":
        return CONTEXT
    if case["kind"] == "stability":
        return (case["observed_arm"],)
    return PAIR


def check_rules(case):
    kind, rules = case["kind"], case["rules"]
    if kind in ("throughput", "latency", "context"):
        require(rules["throughput_basis"] in ("completed_in_window", "successful_tokens_in_window"),
                "Freeze the successful-output window counting rule")
    if kind in ("latency", "context"):
        require(count(rules["min_samples"], "min_samples") > 0, "min_samples must be positive")
    if kind == "latency":
        require(type(rules["mixed_prefill_decode"]) is bool, "Declare whether mixed prefill/decode waves are tested")
    if kind == "context":
        number(rules["min_throughput_retention_ratio"], "throughput retention", positive=True)
        for metric in TAILS:
            number(rules["max_tail_ratio"][metric], metric, positive=True)
        count(rules["max_consecutive_degraded_windows"], "max_consecutive_degraded_windows")
        require(count(rules["trend_min_long_requests"], "trend_min_long_requests") > 0,
                "Each long window needs actual 16K coverage")
        require(count(rules["trend_min_samples"], "trend_min_samples") > 0, "trend_min_samples must be positive")
        for key in ("min_window_s", "trend_window_s", "short_min_tokens", "short_max_tokens"):
            number(rules[key], key, positive=True)
        require(count(rules["min_long_requests"], "min_long_requests") > 0, "At least one actual 16K request is required")
        require(rules["short_min_tokens"] <= 4096 <= rules["short_max_tokens"] < 16384,
                "4K context range must contain 4096 and stay below 16K")
    if kind == "cost":
        number(rules["days_per_month"], "days_per_month", positive=True)
        number(rules["min_util_gain_pp"], "AI Core improvement in percentage points", positive=True, maximum=100)
    if kind == "stability":
        require(case["dataset"] in DATASETS and case["observed_arm"] in PAIR, "Invalid stability dataset or arm")


def load_plan(path, digest, selected=None):
    root = path.resolve().parent
    lock(root, path.name, digest)
    plan = json_read(path)
    require(plan["schema"] == "vllm-hust-inference-test-plan/v1", "Unsupported plan schema")
    require(plan["project"] == "2025ZD0123800" and plan["model"] == "Qwen3.5-35B-A3B"
            and plan["device"] == "Ascend 910B2" and plan["devices"] == 2,
            "Model and device must match the attached plan")
    errors = []
    for name in ("version", "approval_record", "site"):
        if not plan.get(name):
            errors.append(f"Fill {name}")
    try:
        files = plan["files"]
        require(plan["approval_record"] in files, "Include approval record in files")
        for name, expected in files.items():
            lock(root, name, expected)
    except (ValueError, KeyError, TypeError, OSError) as error:
        errors.append(str(error))

    cases = plan["cases"]
    ids = set()
    for case in cases:
        try:
            name = case["id"]
            require(re.fullmatch(r"[a-z0-9][a-z0-9-]*", name) is not None and name not in ids, "Invalid or duplicate case ID")
            ids.add(name)
            require(case["kind"] in ROLES, "Unknown test kind")
            if selected and name not in selected:
                continue
            check_rules(case)
            require(case["contract"] in files, "Freeze workload, measurement boundary, cache, quality/SLO and rules in a locked contract")
            contract = json_read(local_file(root, case["contract"]))
            for field in ("workload", "request_policy", "cache_policy", "measurement", "quality_slo", "failure_policy"):
                require(contract.get(field), f"Contract field required: {field}")
            require(contract.get("repeat_rule") in ("all_pairs", "report_only"),
                    "Freeze repeat_rule (all_pairs or report_only)")
            if case["kind"] == "context":
                require(case["context_engine"] in PAIR, "Freeze the engine for the 4K/16K comparison")
            arms = expected_arms(case)
            require(set(case["arms"]) == set(arms), "Unexpected arm names")
            require(isinstance(case["sequence"], list) and case["sequence"], "Freeze repetition count and execution order")
            for order in case["sequence"]:
                require(sorted(order) == sorted(arms), "Each repeat must contain exactly the declared arms")
            if case["kind"] == "stability":
                require(case["task_ids"] in files, "Lock the approved task ID list")
                tasks = json_read(local_file(root, case["task_ids"]))
                require(isinstance(tasks, list) and tasks and all(isinstance(x, str) and x for x in tasks)
                        and len(tasks) == len(set(tasks)), "Invalid or duplicate task IDs")
            for arm in arms:
                spec = case["arms"][arm]
                require(spec["config"] in files, f"{arm}: freeze deployment configuration")
                require(("argv" in spec) != ("reuse" in spec), f"{arm}: choose execution or archived reuse")
                config = json_read(local_file(root, spec["config"]))
                require(config["source_weights"] and config["runtime_identity"] and config["parallelism"]
                        and config["precision"], f"{arm}: incomplete deployment configuration")
                if arm == "B0" or case.get("context_engine") == "B0":
                    require(config["engine"] == "vLLM" and config["plugin"] == "vLLM-Ascend"
                            and all(re.fullmatch(r"0\.18(?:\.\d+)?", config[key])
                                    for key in ("engine_version", "plugin_version")),
                            f"{arm}: expected approved vLLM/vLLM-Ascend 0.18")
                if arm == "B1" or case.get("context_engine") == "B1":
                    require(config["engine"] == "vLLM-HUST" and config["plugin"] == "vllm-ascend-hust"
                            and config["engine_version"] and config["plugin_version"],
                            f"{arm}: expected exact vLLM-HUST and Ascend plugin identity")
                if "argv" in spec:
                    argv = spec["argv"]
                    require(isinstance(argv, list) and len(argv) >= 2 and all(isinstance(x, str) for x in argv)
                            and argv[0] == "python3" and argv[1] in files,
                            f"{arm}: use python3 and a locked local adapter path")
                    number(spec["timeout_s"], "timeout_s", positive=True)
                    if argv[1] == "run_native.py":
                        require(len(argv) == 3 and argv[2] in files, f"{arm}: lock the native workflow")
                        workflow = json_read(local_file(root, argv[2]))
                        require(workflow.get("schema") == "vllm-hust-native-workflow/v1" and workflow.get("steps"),
                                f"{arm}: invalid native workflow")
                        timeout_sum = 0
                        for step in workflow["steps"] + workflow.get("cleanup", []):
                            require(step["name"] and isinstance(step["argv"], list) and step["argv"]
                                    and all(isinstance(x, str) and x for x in step["argv"]),
                                    f"{arm}: each native step needs an argv")
                            timeout_sum += number(step["timeout_s"], "stage timeout_s", positive=True)
                        require(spec["timeout_s"] > timeout_sum, f"{arm}: outer timeout must include all stages and cleanup")
                else:
                    require(len(spec["reuse"]) == len(case["sequence"]), f"{arm}: supply one archived receipt per repeat")
                    for receipt in spec["reuse"]:
                        require(receipt in files, f"{arm}: lock archived receipt")
                        archived = json_read(local_file(root, receipt))
                        parent = PurePosixPath(receipt).parent
                        for item in archived["evidence"].values():
                            require(str(parent / item) in files, f"{arm}: lock reused evidence {item}")
            weights = {json_read(local_file(root, case["arms"][arm]["config"]))["source_weights"] for arm in arms}
            require(len(weights) == 1, "Source weights differ between arms")
            if case["kind"] == "cost":
                for arm in arms:
                    number(case["arms"][arm]["fee_per_card_month_cny"], f"{arm} monthly fee", positive=True)
        except (KeyError, ValueError, TypeError, OSError) as error:
            errors.append(f"{case.get('id', '?')}: {error}")
    for kind in ("compute", "throughput", "latency", "context", "cost"):
        if not any(case.get("kind") == kind for case in cases):
            errors.append(f"Missing case kind: {kind}")
    covered = {case.get("dataset") for case in cases
               if case.get("kind") == "stability" and case.get("observed_arm") == "B1"}
    if not selected:
        if not DATASETS.issubset(covered):
            errors.append(f"Missing B1 stability datasets: {', '.join(sorted(DATASETS - covered))}")
        if not any(case.get("kind") == "context" and case.get("context_engine") == "B1" for case in cases):
            errors.append("Missing B1 4K/16K context comparison")
    if selected and not set(selected).issubset(ids):
        errors.append("Unknown case ID")
    require(not errors, "\n".join(errors))
    return root, plan


def read_requests(path):
    rows = [json.loads(line) for line in path.read_text(encoding="utf-8-sig").splitlines() if line.strip()]
    require(rows, "No request records")
    ids = set()
    for row in rows:
        key = row["id"]
        require(isinstance(key, str) and key and key not in ids, "Missing or duplicate request ID")
        ids.add(key)
        require(row["status"] in ("success", "failed", "timeout", "unfinished"), f"{key}: invalid status")
        number(row["sent_s"], "sent_s")
        count(row["input_tokens"], "input_tokens")
        count(row["output_tokens"], "output_tokens")
        if row["status"] == "success":
            end = number(row["end_s"], "end_s")
            require(end >= row["sent_s"] and row["finish_reason"], f"{key}: invalid end or missing finish reason")
            if row["output_tokens"]:
                first = number(row["first_s"], "first_s")
                require(row["sent_s"] <= first <= end, f"{key}: invalid first-token time")
    return rows


def percentile(values, p):
    if not values:
        return None
    ordered = sorted(values)
    index = (len(ordered) - 1) * p
    lower, upper = math.floor(index), math.ceil(index)
    return ordered[lower] + (ordered[upper] - ordered[lower]) * (index - lower)


def window_stats(rows, start, end, basis):
    cohort = [row for row in rows if start <= row["sent_s"] < end]
    complete = [row for row in cohort if row["status"] == "success" and row["end_s"] <= end]
    success = [row for row in rows if row["status"] == "success" and row["sent_s"] < end and row["end_s"] >= start]
    if basis == "successful_tokens_in_window":
        tokens = 0
        for row in success:
            amount = count(row["window_output_tokens"], "window_output_tokens")
            require(amount <= row["output_tokens"], "Window token count exceeds request output")
            tokens += amount
    else:
        tokens = sum(row["output_tokens"] for row in complete)
    ttft = [1000 * (row["first_s"] - row["sent_s"]) for row in complete if row["output_tokens"] > 0]
    tpot = [1000 * (row["end_s"] - row["first_s"]) / (row["output_tokens"] - 1)
            for row in complete if row["output_tokens"] > 1]
    return {
        "duration_s": end - start, "started": len(cohort), "completed_in_window": len(complete),
        "failures": sum(row["status"] == "failed" for row in cohort),
        "timeouts": sum(row["status"] == "timeout" for row in cohort),
        "unfinished_at_boundary": sum(row["status"] == "unfinished" or
                                       (row["status"] == "success" and row["end_s"] > end) for row in cohort),
        "cross_window_successes": len(success) - len(complete),
        "output_tokens": tokens, "output_tps": tokens / (end - start),
        "ttft_samples": len(ttft), "tpot_samples": len(tpot),
        "ttft_mean_ms": statistics.mean(ttft) if ttft else None,
        "tpot_mean_ms": statistics.mean(tpot) if tpot else None,
        "ttft_p95_ms": percentile(ttft, .95), "ttft_p99_ms": percentile(ttft, .99),
        "tpot_p95_ms": percentile(tpot, .95), "tpot_p99_ms": percentile(tpot, .99),
        "contexts_at_least_16k": sum(row["input_tokens"] + row["output_tokens"] >= 16384 for row in complete),
    }, complete


def context_trend(rows, start, end, basis, interval):
    if basis == "successful_tokens_in_window":
        for row in rows:
            if row["status"] != "success" or row["sent_s"] >= end or row["end_s"] < start:
                continue
            chunks = row["output_chunks"]
            for timestamp, tokens in chunks:
                require(row["sent_s"] <= number(timestamp, "chunk timestamp") <= row["end_s"],
                        "Chunk outside request lifetime")
                count(tokens, "chunk output tokens")
            require(sum(tokens for timestamp, tokens in chunks if start <= timestamp < end)
                    == row["window_output_tokens"], "Window count differs from original chunks")
            require(sum(tokens for _, tokens in chunks) == row["output_tokens"], "Chunks do not cover request output")
    windows = []
    offset = 0
    while start + offset < end:
        low, high = start + offset, min(start + offset + interval, end)
        require(high > low, "Trend window too short for time precision")
        if basis == "successful_tokens_in_window":
            subset = [dict(row, window_output_tokens=sum(tokens for ts, tokens in row["output_chunks"]
                           if low <= ts < high)) if row["status"] == "success" else row
                      for row in rows if row["sent_s"] < high
                      and (row["status"] != "success" or row["end_s"] >= low)]
        else:
            subset = rows
        metrics, _ = window_stats(subset, low, high, basis)
        windows.append(dict(metrics, start_s=low, end_s=high))
        offset += interval
    return windows


def mixed_wave_metrics(path, complete, start, end):
    by_id = {row["id"]: row for row in complete if row["output_tokens"] > 1}
    waves = json_read(path)
    require(isinstance(waves, list) and waves, "No mixed prefill/decode waves")
    metrics = []
    for wave in waves:
        low, high = number(wave["start_s"], "wave start"), number(wave["end_s"], "wave end")
        require(start <= low < high <= end, "Wave must lie inside the measurement window")
        ids = wave["request_ids"]
        require(ids and len(ids) == len(set(ids)) and set(ids).issubset(by_id),
                "Wave needs unique requests with valid TPOT")
        samples = [1000 * (by_id[key]["end_s"] - by_id[key]["first_s"])
                   / (by_id[key]["output_tokens"] - 1) for key in ids]
        metrics.append({"start_s": low, "duration_s": high - low,
                        "tpot_p99_ms": percentile(samples, .99), "samples": len(samples)})
    return metrics


def read_review(path):
    review = json_read(path)
    require(type(review["passed"]) is bool and review["basis"], "Review must include passed and supporting basis")
    return review


def utilization(path, cards, start, end):
    by_card = {card: [] for card in cards}
    for row in json_read(path):
        card = row["card"]
        require(card in by_card, "Unexpected device in AI Core samples")
        low = max(start, number(row["start_s"], "util.start_s"))
        high = min(end, number(row["end_s"], "util.end_s"))
        if high > low:
            by_card[card].append((low, high, number(row["ai_core_pct"], "ai_core_pct", maximum=100)))
    averages = {}
    for card, samples in by_card.items():
        edge = start
        integral = 0
        for low, high, pct in sorted(samples):
            require(math.isclose(low, edge, abs_tol=1e-6, rel_tol=0), f"{card}: utilization intervals have gap or overlap")
            integral += pct * (high - low)
            edge = high
        require(math.isclose(edge, end, abs_tol=1e-6, rel_tol=0), f"{card}: incomplete utilization coverage")
        averages[card] = integral / (end - start)
    return averages


def assess(root, plan, case, arm, repeat, folder):
    receipt = json_read(local_file(folder, "receipt.json"))
    spec = case["arms"][arm]
    identity = {
        "case": case["id"], "arm": arm, "repeat": repeat,
        "contract_sha256": plan["files"][case["contract"]], "config_sha256": plan["files"][spec["config"]],
    }
    require(all(receipt.get(k) == v for k, v in identity.items())
            and isinstance(receipt["run_id"], str) and receipt["run_id"],
            "Receipt does not bind this case, arm, repeat, contract and deployment")
    cards = receipt["cards"]
    require(isinstance(cards, list) and len(cards) == len(set(cards)) == plan["devices"] and all(cards),
            "Record both actual occupied physical devices as node/card")
    evidence = {key: local_file(folder, path) for key, path in receipt["evidence"].items()}
    kind = case["kind"]
    require(set(ROLES[kind]).issubset(evidence), f"Missing evidence roles: {sorted(set(ROLES[kind]) - set(evidence))}")
    require(all(path.stat().st_size for path in evidence.values()), "Evidence files must be nonempty")
    result = {"run_id": receipt["run_id"], "cards": cards}
    if kind == "compute":
        flops = count(receipt["effective_flops"], "effective_flops")
        require(flops > 0 and receipt["same_run_f_t"] is True and receipt["measurement_method"],
                "F and T must be attributable to the same run")
        seconds = number(receipt["synchronized_s"], "synchronized_s", positive=True)
        reference = number(receipt["reference_tflops_per_card"], "reference_tflops_per_card", positive=True)
        require(receipt["reference_time_kind"] in ("derived_equivalent", "direct_same_work"), "Classify Tref")
        compute = flops / (len(cards) * seconds * 1e12)
        equivalent = flops / (len(cards) * reference * 1e12)
        if receipt["reference_time_kind"] == "direct_same_work":
            require(math.isclose(equivalent, number(receipt["reference_s"], "reference_s", positive=True), rel_tol=1e-6),
                    "Direct Tref disagrees with F, k and reference")
        review = read_review(evidence["reference_review"])
        result.update(effective_flops=flops, synchronized_s=seconds, tflops_per_card=compute,
                      reference_tflops_per_card=reference, reference_s=equivalent,
                      reference_time_kind=receipt["reference_time_kind"],
                      measurement_method=receipt["measurement_method"],
                      efficiency_pct=100 * compute / reference, reference_qualified=review["passed"])
        return result

    start = number(receipt["start_s"], "start_s")
    end = number(receipt["end_s"], "end_s", positive=True)
    require(end > start, "Measurement window is empty")
    rows = read_requests(evidence["requests"])
    rules = case["rules"]
    stats, complete = window_stats(rows, start, end, rules.get("throughput_basis", "completed_in_window"))
    result.update(stats)
    if kind in ("throughput", "latency", "cost"):
        for role in ("quality_review", "slo_review"):
            result[role] = read_review(evidence[role])
    if kind == "latency" and rules["mixed_prefill_decode"]:
        require("mixed_waves" in evidence, "Missing mixed prefill/decode wave evidence")
        result["mixed_wave_metrics"] = mixed_wave_metrics(evidence["mixed_waves"], complete, start, end)
    if kind in ("stability", "context"):
        incident = json_read(evidence["incident_review"])
        require(incident["basis"] and type(incident["continuous"]) is bool, "Incident review must cover the window")
        result["incidents"] = {key: count(incident[key], key) for key in INCIDENTS}
        result["continuous"] = incident["continuous"]
    if kind == "stability":
        approved = set(json_read(local_file(root, case["task_ids"])))
        tasks = json_read(evidence["task_results"])
        task_ids = [item["id"] for item in tasks]
        require(len(task_ids) == len(set(task_ids)) and set(task_ids) == approved,
                "Task results do not cover the frozen list exactly")
        require(all(item["state"] in ("completed", "failed", "timeout", "not_run") and item["split"] for item in tasks),
                "Invalid task state or missing split/modality")
        splits = {}
        for item in tasks:
            row = splits.setdefault(item["split"], {})
            row[item["state"]] = row.get(item["state"], 0) + 1
        result.update(tasks=len(approved), tasks_completed=sum(item["state"] == "completed" for item in tasks),
                      task_states_by_split=splits)
    if kind == "context":
        result["trend_windows"] = context_trend(rows, start, end, rules["throughput_basis"], rules["trend_window_s"])
    if kind == "context" and arm == "4K":
        lengths = [row["input_tokens"] + row["output_tokens"] for row in complete]
        result["short_range_match"] = bool(lengths) and all(
            rules["short_min_tokens"] <= length <= rules["short_max_tokens"] for length in lengths
        )
    if kind == "cost":
        require(complete and stats["output_tokens"] > 0, "No positive in-window output for cost")
        cached = [count(row["cached_input_tokens"], "cached_input_tokens") for row in complete]
        require(all(n <= row["input_tokens"] for n, row in zip(cached, complete)), "Cached tokens exceed input tokens")
        fee = spec["fee_per_card_month_cny"] * len(cards) * (end - start) / (86400 * rules["days_per_month"])
        averages = utilization(evidence["utilization"], cards, start, end)
        included = {row["id"] for row in complete}
        crossed = [row for row in rows if row["status"] == "success" and row["sent_s"] < end
                   and row["end_s"] >= start and row["id"] not in included]
        result.update(fee_cny=fee, cny_per_million_output=1e6 * fee / stats["output_tokens"],
                      cross_window_input_tokens=sum(row["input_tokens"] for row in crossed),
                      cross_window_output_tokens=sum(row["output_tokens"] for row in crossed),
                      cached_input_tokens=sum(cached), new_input_tokens=sum(row["input_tokens"] for row in complete) - sum(cached),
                      ai_core_pct_by_card=averages, ai_core_pct=statistics.mean(averages.values()))
    return result


def ratio(numerator, denominator):
    require(numerator is not None and denominator is not None and denominator > 0,
            "Missing measurement or zero denominator")
    return numerator / denominator


def context_comparison(short, long, rules, sample_rule):
    for value in (short, long):
        require(min(value["ttft_samples"], value["tpot_samples"]) >= rules[sample_rule],
                "Insufficient TTFT or TPOT samples")
    rates = {metric: ratio(long[metric], short[metric]) for metric in TAILS}
    retention = ratio(long["output_tps"], short["output_tps"])
    meets = (retention >= rules["min_throughput_retention_ratio"]
             and all(rates[key] <= rules["max_tail_ratio"][key] for key in TAILS))
    return {"throughput_retention_ratio": retention, "tail_ratios": rates}, meets


def compare(case, arms):
    kind, rules = case["kind"], case["rules"]
    if kind == "stability":
        value = arms[case["observed_arm"]]
        return {}, {"continuous_log": value["continuous"],
                    "complete_task_list": value["tasks"] == value["tasks_completed"],
                    "no_critical_incidents": not any(value["incidents"].values())}
    if kind == "context":
        short, long = (arms[name] for name in CONTEXT)
        overall, meets_window = context_comparison(short, long, rules, "min_samples")
        short_windows, long_windows = short["trend_windows"], long["trend_windows"]
        require(len(short_windows) == len(long_windows), "4K and 16K trend windows do not align")
        windows = []
        consecutive = longest = 0
        for low, high in zip(short_windows, long_windows):
            require(math.isclose(low["duration_s"], high["duration_s"], abs_tol=1e-6),
                    "4K and 16K trend window durations differ")
            metrics, meets = context_comparison(low, high, rules, "trend_min_samples")
            meets = meets and high["contexts_at_least_16k"] >= rules["trend_min_long_requests"]
            windows.append(dict(metrics, meets=meets, actual_16k_requests=high["contexts_at_least_16k"]))
            consecutive = 0 if meets else consecutive + 1
            longest = max(longest, consecutive)
        checks = {
            "4k_workload_coverage": short["short_range_match"],
            "16k_workload_coverage": (long["contexts_at_least_16k"] >= rules["min_long_requests"]
                                     and all(window["actual_16k_requests"] >= rules["trend_min_long_requests"]
                                             for window in windows)),
            "continuous_incident_free_windows": all(value["continuous"] and value["duration_s"] >= rules["min_window_s"]
                                                     and not any(value["incidents"].values()) for value in (short, long)),
            "throughput_and_tail_ratios": meets_window,
            "sustained_degradation_limit": longest <= rules["max_consecutive_degraded_windows"],
        }
        return dict(overall, trend_window_comparisons=windows, longest_degraded_window_run=longest), checks
    b0, b1 = (arms[name] for name in PAIR)
    if kind == "compute":
        require(b0["reference_qualified"] and b1["reference_qualified"], "Reference eligibility not established")
        return {}, {"effective_compute_efficiency": b1["efficiency_pct"] >= THRESHOLDS["compute_efficiency_pct"]}
    checks = {f"{arm}_{key}": arms[arm][key]["passed"] for arm in PAIR for key in ("quality_review", "slo_review")}
    if kind == "throughput":
        gain = 100 * (ratio(b1["output_tps"], b0["output_tps"]) - 1)
        checks["throughput_gain"] = gain >= THRESHOLDS["throughput_gain_pct"] - 1e-9
        return {"throughput_gain_pct": gain}, checks
    if kind == "latency":
        for value in (b0, b1):
            require(min(value["ttft_samples"], value["tpot_samples"]) >= rules["min_samples"],
                    "Insufficient TTFT or TPOT samples")
        gains = {key: 100 * (1 - ratio(b1[key], b0[key])) for key in ("ttft_mean_ms", "tpot_mean_ms")}
        for name, gain in gains.items():
            checks[name + "_improvement"] = gain >= THRESHOLDS["latency_improvement_pct"] - 1e-9
        return {"improvement_pct": gains}, checks
    reduction = 100 * (1 - ratio(b1["cny_per_million_output"], b0["cny_per_million_output"]))
    utilization_gain = b1["ai_core_pct"] - b0["ai_core_pct"]
    checks["cost_reduction"] = reduction >= THRESHOLDS["cost_reduction_pct"] - 1e-9
    checks["ai_core_utilization_gain"] = utilization_gain >= rules["min_util_gain_pp"]
    return {"cost_reduction_pct": reduction, "ai_core_gain_pp": utilization_gain}, checks


def execute(root, plan, case, arm, repeat, folder):
    folder.mkdir(parents=True)
    spec = case["arms"][arm]
    if "reuse" in spec:
        source = local_file(root, spec["reuse"][repeat - 1])
        receipt = json_read(source)
        lock(root, spec["reuse"][repeat - 1], plan["files"][spec["reuse"][repeat - 1]])
        for item in receipt["evidence"].values():
            origin = local_file(source.parent, item)
            rel = origin.relative_to(root).as_posix()
            lock(root, rel, plan["files"][rel])
            target = folder.joinpath(*PurePosixPath(item).parts)
            target.parent.mkdir(parents=True, exist_ok=True)
            shutil.copyfile(origin, target)
        shutil.copyfile(source, folder / "receipt.json")
        return
    argv = spec["argv"]
    adapter = lock(root, argv[1], plan["files"][argv[1]])
    env = os.environ.copy()
    env.update(VLLM_HUST_TEST_OUTPUT=str(folder), VLLM_HUST_TEST_CASE=case["id"], VLLM_HUST_TEST_ARM=arm,
               VLLM_HUST_TEST_REPEAT=str(repeat), VLLM_HUST_TEST_CONTRACT=str(root / case["contract"]),
               VLLM_HUST_TEST_CONFIG=str(root / spec["config"]))
    json_write(folder / "invocation.json", {"argv": argv, "utc_start": datetime.now(timezone.utc).isoformat()})
    with (folder / "adapter.log").open("wb") as log:
        result = subprocess.run([sys.executable, str(adapter), *argv[2:]], cwd=root, env=env,
                                stdout=log, stderr=subprocess.STDOUT, timeout=spec["timeout_s"])
    require(result.returncode == 0, f"Adapter exited {result.returncode}; see {folder / 'adapter.log'}")


def case_rows(root, plan, cases, out, run):
    rows = []
    run_ids = set()
    stopped = False
    for case in cases:
        contract = json_read(local_file(root, case["contract"]))
        for repeat, order in enumerate(case["sequence"], 1):
            arms = {}
            row = {"case": case["id"], "kind": case["kind"], "repeat": repeat, "arms": arms}
            if stopped:
                rows.append(dict(row, status="unassessable", reason="Earlier adapter execution failed"))
                continue
            try:
                for arm in order:
                    folder = out / case["id"] / f"r{repeat:03d}" / arm
                    error_path = folder / "execution-error.json"
                    if run:
                        try:
                            execute(root, plan, case, arm, repeat, folder)
                        except (OSError, KeyError, ValueError, TypeError, subprocess.SubprocessError) as error:
                            folder.mkdir(parents=True, exist_ok=True)
                            json_write(error_path, {"reason": str(error)})
                    if error_path.exists():
                        stopped = True
                        raise ValueError(json_read(error_path)["reason"])
                    result = assess(root, plan, case, arm, repeat, folder)
                    require(result["run_id"] not in run_ids, "Duplicate run ID")
                    run_ids.add(result["run_id"])
                    arms[arm] = result
                row["comparison"], row["checks"] = compare(case, arms)
                unmet = [name for name, passed in row["checks"].items() if not passed]
                row["status"] = "criteria_not_met" if unmet else "criteria_met"
                if unmet:
                    row["reason"] = ", ".join(unmet)
                if contract["repeat_rule"] == "report_only":
                    row["per_pair_status"] = row["status"]
                    row["status"] = "manual_repeat_review"
            except (OSError, KeyError, ValueError, TypeError, subprocess.SubprocessError) as error:
                row.update(status="unassessable", reason=str(error))
            rows.append(row)
    return rows


def inventory(out):
    return {p.relative_to(out).as_posix(): sha256(p) for p in sorted(out.rglob("*"))
            if p.is_file() and p != out / "checksums.json"}


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("action", choices=("preflight", "run", "review"))
    parser.add_argument("--plan", required=True, type=Path)
    parser.add_argument("--sha256", required=True, help="Approved plan SHA-256, obtained independently")
    parser.add_argument("--out", type=Path)
    parser.add_argument("--case", action="append", help="Select a case ID (repeatable)")
    args = parser.parse_args()
    root, plan = load_plan(args.plan, args.sha256, args.case)
    cases = [case for case in plan["cases"] if not args.case or case["id"] in args.case]
    require(cases and (not args.case or set(args.case) == {c["id"] for c in cases}), "Unknown case ID")
    if args.action == "preflight":
        plotter()
        print("PREFLIGHT OK:", ", ".join(case["id"] for case in cases))
        return 0
    require(args.out is not None, "--out is required for run and review")
    out = args.out.resolve()
    if args.action == "run":
        plt = plotter()
        require(not out.exists(), "Use a new output directory for each campaign")
        out.mkdir(parents=True)
        shutil.copyfile(args.plan, out / "frozen-plan.json")
    else:
        lock(out, "frozen-plan.json", args.sha256)
        require(json_read(out / "checksums.json") == inventory(out), "Output evidence inventory or digest differs")
        prior = json_read(out / "summary.json")
        require(not args.case or set(args.case) == set(prior["cases"]),
                "Review the same case selection as the sealed campaign")
        selected = set(prior["cases"])
        cases = [case for case in cases if case["id"] in selected]
    rows = case_rows(root, plan, cases, out, args.action == "run")
    complete_plan = not args.case and len(cases) == len(plan["cases"])
    if args.action == "review":
        complete_plan = prior["complete_plan"]
    targets = {section: disposition([row for row in rows if row["kind"] in kinds])
               for section, _, kinds, _ in SECTIONS}
    summary = {"plan_sha256": args.sha256, "cases": [c["id"] for c in cases],
               "complete_plan": complete_plan, "thresholds": THRESHOLDS, "targets": targets,
               "overall_status": disposition(rows) if complete_plan else "partial", "results": rows}
    if args.action == "run":
        json_write(out / "summary.json", summary)
        write_report(out, cases, summary, plt)
        json_write(out / "checksums.json", inventory(out))
        print(f"Report: {out / 'report.html'}")
    else:
        require(summary == prior, "Recomputation disagrees with sealed result")
    for row in rows:
        print(f"{row['case']} r{row['repeat']:03d} {row['status']}: {row.get('reason', '')}")
    return 1 if any(row["status"] != "criteria_met" for row in rows) else 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (OSError, KeyError, ValueError, TypeError) as error:
        print(f"BLOCKED: {error}", file=sys.stderr)
        sys.exit(2)




