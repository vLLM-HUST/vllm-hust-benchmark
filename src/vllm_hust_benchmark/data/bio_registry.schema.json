{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "asset_manifest",
    "legacy_phase1_regression",
    "components",
    "contracts",
    "profiles",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "asset_manifest": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*\\.json$"
    },
    "legacy_phase1_regression": {
      "type": "boolean"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "kind",
          "interface_version",
          "entrypoint"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "driver",
              "input",
              "reference",
              "evaluator",
              "collector"
            ]
          },
          "interface_version": {
            "type": "integer",
            "const": 1
          },
          "entrypoint": {
            "type": "string",
            "pattern": "^[a-zA-Z_][a-zA-Z0-9_.]*:[a-zA-Z_][a-zA-Z0-9_]*$"
          }
        }
      }
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "operation",
          "input_type",
          "output_type",
          "parameters"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "operation": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "input_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "output_type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "parameters": {
            "type": "object"
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "version",
          "asset_id",
          "driver",
          "input",
          "reference",
          "evaluator",
          "collector",
          "limits",
          "capabilities",
          "tasks",
          "rejection_probes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "version": {
            "type": "integer",
            "minimum": 1
          },
          "asset_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
          },
          "driver": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "config": {
                "type": "object"
              }
            }
          },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "config": {
                "type": "object"
              }
            }
          },
          "reference": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "config": {
                "type": "object"
              }
            }
          },
          "evaluator": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "config": {
                "type": "object"
              }
            }
          },
          "collector": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "version"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
              },
              "version": {
                "type": "integer",
                "minimum": 1
              },
              "config": {
                "type": "object"
              }
            }
          },
          "limits": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "max_context",
              "dtypes",
              "enforce_eager",
              "input_alphabet"
            ],
            "properties": {
              "max_context": {
                "type": "integer",
                "minimum": 1
              },
              "dtypes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              },
              "enforce_eager": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "boolean"
                }
              },
              "input_alphabet": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "capabilities": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "batch",
              "streaming",
              "cancel",
              "concurrency"
            ],
            "properties": {
              "batch": {
                "type": "boolean"
              },
              "streaming": {
                "type": "boolean"
              },
              "cancel": {
                "type": "boolean"
              },
              "concurrency": {
                "type": "boolean"
              }
            }
          },
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "contract"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                },
                "contract": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "evaluator": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "id",
                    "version"
                  ],
                  "properties": {
                    "id": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]*$"
                    },
                    "version": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "config": {
                      "type": "object"
                    }
                  }
                }
              }
            }
          },
          "rejection_probes": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "number",
        "minimum": 0
      }
    },
    "scientist_sources": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_.-]*(/[A-Za-z0-9_-][A-Za-z0-9_.-]*)*$"
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
